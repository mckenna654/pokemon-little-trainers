-                if (var == MON_HAS_MAX_MOVES)
+                if (var == MON_HAS_MAX_MOVES && LT_Rules()->autoLearnMoves)
+                {
+                    // Little Trainers: no "forget a move?" questions. Swap the new move in for
+                    // the weakest one, or skip it and look for the next move at this level.
+                    u8 slot = LT_ChooseMoveSlotToReplace(mon, gMoveToLearn);
