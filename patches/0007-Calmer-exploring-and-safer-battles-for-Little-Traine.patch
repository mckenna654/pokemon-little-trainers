From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mckenna654 <mckenna654@gmail.com>
Date: Tue, 24 Nov 2026 18:08:56 +1100
Subject: Calmer exploring and safer battles for Little Trainers

Wild encounters are half as frequent, the player's side is protected from
status conditions for the whole battle (a permanent Safeguard), a full move
list no longer raises questions during evolution, and pressing B cannot
cancel an evolution.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/include/little_trainers.h b/include/little_trainers.h
index b032312f3..eb2d1d79a 100644
--- a/include/little_trainers.h
+++ b/include/little_trainers.h
@@ -43,9 +43,15 @@ struct LtRules
     u8 enemyDamagePercent;      // damage dealt by opposing Pokemon (100 = original)
     bool8 alwaysRunAway;        // running from a wild Pokemon never fails
     bool8 noPlayerRecoil;       // the player's Pokemon take no recoil damage from their own moves
+    bool8 playerStatusShield;   // the player's side is always protected from sleep, poison, burn,
+                                // freeze, paralysis and confusion (a permanent Safeguard)
 
-    // Moves
+    // Exploring
+    u8 encounterRatePercent;    // how often wild Pokemon appear (100 = original)
+
+    // Moves and evolution
     bool8 autoLearnMoves;       // new moves replace the weakest one automatically, no prompts
+    bool8 noEvolutionCancel;    // pressing B during an evolution does not stop it
 
     // Interface
     bool8 simpleBattleMenu;     // ATTACK / SPECIAL / CATCH / RUN instead of the move list and bag
@@ -71,6 +77,9 @@ bool32 LT_BattleRulesActive(void);
 // Called once when a battle is being set up.
 void LT_OnBattleStart(void);
 
+// Called after the engine has reset its per-battle state.
+void LT_OnBattleDataCleared(void);
+
 // How suitable a move is for a young player: 0 = never choose it (no damage, or a confusing or
 // self-harming effect), otherwise larger is better (roughly power x accuracy).
 u16 LT_MoveScore(u16 move);
