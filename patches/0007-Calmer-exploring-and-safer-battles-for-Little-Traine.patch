+void LT_OnBattleDataCleared(void)
+{
+    if (LT_BattleRulesActive() && LT_Rules()->playerStatusShield)
+    {
+        // A Safeguard that lasts the whole battle. The engine and the opponent's AI already
+        // understand Safeguard, so no status code needs changing.
+        gSideStatuses[B_SIDE_PLAYER] |= SIDE_STATUS_SAFEGUARD;
+        gSideTimers[B_SIDE_PLAYER].safeguardTimer = 255;
+        gSideTimers[B_SIDE_PLAYER].safeguardBattlerId = 0;
+    }
+}
