Subject: Cap opponent team sizes by preset

Ordinary trainers bring at most 2 Pokemon on the Little Trainer preset, gym
leaders 2 growing to 4 with the player's badges, and the rival, Elite Four
and Champion 4. The last Pokemon of each team (the strongest) is kept.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/include/little_trainers.h b/include/little_trainers.h
index ed8267441..d02e138b6 100644
--- a/include/little_trainers.h
+++ b/include/little_trainers.h
@@ -49,6 +49,11 @@ struct LtRules
     // Exploring
     u8 encounterRatePercent;    // how often wild Pokemon appear (100 = original)
 
+    // Opponent trainers: the most Pokemon a team may bring (6 = original teams)
+    u8 trainerPartyCap;         // ordinary trainers
+    u8 leaderPartyCap;          // gym leaders before any badge; grows by one every three badges
+    u8 bossPartyCap;            // rival, Elite Four and Champion
+
     // Moves and evolution
     bool8 autoLearnMoves;       // new moves replace the weakest one automatically, no prompts
     bool8 noEvolutionCancel;    // pressing B during an evolution does not stop it
@@ -118,6 +123,9 @@ void LT_DrawStartMenuIcon(u8 windowId, u8 startMenuItem, u8 y);
 // 8x8 heart tile for one slice of the HP bar with 0-8 of its pixels filled.
 const u8 *LT_HeartTile(u8 filledPixels);
 
+// How many Pokemon the given trainer brings under the active preset.
+u8 LT_TrainerPartyCap(u16 trainerNum);
+
 // Scales damage for the attacker's side according to the active preset.
 s32 LT_ScaleDamage(s32 damage, u8 battlerAttacker);
 
diff --git a/src/battle_main.c b/src/battle_main.c
index 2848f25a2..61da14768 100644
--- a/src/battle_main.c
+++ b/src/battle_main.c
@@ -1635,6 +1635,22 @@ static u8 CreateNPCTrainerParty(struct Pokemon *party, u16 trainerNum)
         }
 
         gBattleTypeFlags |= gTrainers[trainerNum].doubleBattle;
+
+        // Little Trainers: shorter trainer battles. Keep the last Pokemon of the team (a
+        // leader's signature Pokemon comes last) and drop the ones before them.
+        {
+            u8 count = gTrainers[trainerNum].partySize;
+            u8 cap = LT_TrainerPartyCap(trainerNum);
+
+            if (cap < count)
+            {
+                for (i = 0; i < cap; i++)
+                    party[i] = party[count - cap + i];
+                for (; i < count; i++)
+                    ZeroMonData(&party[i]);
+                return cap;
+            }
+        }
     }
 
     return gTrainers[trainerNum].partySize;
