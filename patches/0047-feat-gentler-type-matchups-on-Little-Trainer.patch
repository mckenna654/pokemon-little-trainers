+// Gentler type matchups (gentleTypes), applied once after the type chart, to the overall result the
+// battle message also shows: the player's "not very effective" hits are raised by half (1/2 -> 3/4,
+// 1/4 -> 3/8) and the opponent's "super effective" hits are cut by a quarter (x2 -> x1.5,
+// x4 -> x3). The same for every type and every Pokemon. Mixed matchups that cancel out stay neutral,
+// as their message says; "no effect" stays no effect. Not in the Poke Dude's lessons, which explain
+// the original matchups.
+s32 LT_TypeDamage(s32 damage, u16 moveResultFlags, u8 battlerAttacker)
+{
+    u16 typeFlags = moveResultFlags & (MOVE_RESULT_SUPER_EFFECTIVE | MOVE_RESULT_NOT_VERY_EFFECTIVE);
+
+    if (!LT_BattleRulesActive() || !LT_Rules()->gentleTypes || (gBattleTypeFlags & BATTLE_TYPE_POKEDUDE)
+     || damage <= 0 || (moveResultFlags & MOVE_RESULT_NO_EFFECT))
+        return damage;
+    if (typeFlags == MOVE_RESULT_NOT_VERY_EFFECTIVE && GetBattlerSide(battlerAttacker) == B_SIDE_PLAYER)
+        return damage * 3 / 2;
+    if (typeFlags == MOVE_RESULT_SUPER_EFFECTIVE && GetBattlerSide(battlerAttacker) == B_SIDE_OPPONENT)
+    {
+        damage = damage * 3 / 4;
+        return damage > 0 ? damage : 1;
+    }
+    return damage;
+}
