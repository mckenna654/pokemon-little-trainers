-static void ShowArrow(u8 dir)
+// How far ahead a corner in the path is looked for, in steps: about what is on screen.
+#define DIAGONAL_LOOKAHEAD 7
+
+// The path is a chain of single steps, and a straight arrow shows the next one. When the path
+// turns a corner within a few steps, and taking the corner's direction first is just as good
+// (walking that way meets the same path no later), then both directions are right and the arrow
+// points between them. Returns the corner's direction, or 0 to keep the arrow straight.
+static u8 SecondDirection(u8 dir)
+{
+    s32 px = gSaveBlock1Ptr->pos.x + MAP_OFFSET;
+    s32 py = gSaveBlock1Ptr->pos.y + MAP_OFFSET;
+    s32 width = VMap.Xsize;
+    s32 height = VMap.Ysize;
+    u16 path[DIAGONAL_LOOKAHEAD];       // the tiles the path visits next, in order
+    s32 x = px, y = py;
+    u8 d = dir, turn = 0;
+    u32 length, i, j;
+
+    if (sField == NULL)
+        return 0;
+    for (length = 0; length < DIAGONAL_LOOKAHEAD; )
+    {
+        x += sDirDelta[d][0];
+        y += sDirDelta[d][1];
+        if (x < 0 || y < 0 || x >= width || y >= height)
+            break;
+        path[length++] = y * width + x;
+        d = sField[y * width + x];
+        if (d < DIR_SOUTH || d > DIR_EAST)
+            break; // the goal, or a hop over a ledge: the chain of single steps ends here
+        if (turn == 0 && d != dir)
+            turn = d;
+    }
+    if (turn == 0)
+        return 0;
+
+    // The tile beside the player in the corner's direction: can it be stepped onto, and does
+    // the path from there join the one above without costing a step?
+    x = px + sDirDelta[turn][0];
+    y = py + sDirDelta[turn][1];
+    if (x < 0 || y < 0 || x >= width || y >= height
+     || !SameLevel(px, py, x, y) || SomeoneInTheWay(turn))
+        return 0;
+    for (i = 0; i < DIAGONAL_LOOKAHEAD; i++)
+    {
+        d = sField[y * width + x];
+        for (j = i; j < length; j++)    // (j >= i: reached in no more steps than along the path)
+        {
+            if (path[j] == y * width + x)
+                return turn;
+        }
+        if (d < DIR_SOUTH || d > DIR_EAST)
+            break;
+        x += sDirDelta[d][0];
+        y += sDirDelta[d][1];
+        if (x < 0 || y < 0 || x >= width || y >= height)
+            break;
+    }
+    return 0;
+}
+
+// `dir` is the next step of the path; `dir2`, if not 0, is a second direction that is just as
+// good, and the arrow is drawn pointing between the two.
+static void ShowArrow(u8 dir, u8 dir2)
 {
     static const s8 sBob[] = {0, 1, 2, 1};
     struct Sprite *arrow = ArrowSprite();
     struct Sprite *player = &gSprites[gPlayerAvatar.spriteId];
     s8 bob;
 
+    sShownDir2 = 0;
     if (arrow == NULL)
         return;
     if (dir < DIR_SOUTH || dir > DIR_EAST)
@@ -913,9 +996,23 @@ static void ShowArrow(u8 dir)
     bob = sBob[(sBobTimer++ >> 3) & 3]; // a gentle nudge in the direction to walk
     arrow->oam.paletteNum = player->oam.paletteNum;
     // The camera keeps the player in the middle of the screen: their sprite is centred on (120, 72).
-    arrow->x = 120 + sArrowOffset[dir][0] + sDirDelta[dir][0] * bob;
-    arrow->y = 72 + sArrowOffset[dir][1] + sDirDelta[dir][1] * bob;
-    StartSpriteAnimIfDifferent(arrow, dir - 1);
+    if (dir2 >= DIR_SOUTH && dir2 <= DIR_EAST && sDirDelta[dir][0] * sDirDelta[dir2][0] + sDirDelta[dir][1] * sDirDelta[dir2][1] == 0)
+    {
+        s32 dx = sDirDelta[dir][0] + sDirDelta[dir2][0];    // -1 or 1 each
+        s32 dy = sDirDelta[dir][1] + sDirDelta[dir2][1];
+
+        arrow->x = 120 + dx * (18 + bob);
+        arrow->y = 72 + (dy < 0 ? -14 - bob : 26 + bob);
+        StartSpriteAnimIfDifferent(arrow, dy < 0 ? (dx > 0 ? ARROW_ANIM_NORTH_EAST : ARROW_ANIM_NORTH_WEST)
+                                                 : (dx > 0 ? ARROW_ANIM_SOUTH_EAST : ARROW_ANIM_SOUTH_WEST));
+        sShownDir2 = dir2;
+    }
+    else
+    {
+        arrow->x = 120 + sArrowOffset[dir][0] + sDirDelta[dir][0] * bob;
+        arrow->y = 72 + sArrowOffset[dir][1] + sDirDelta[dir][1] * bob;
+        StartSpriteAnimIfDifferent(arrow, dir - 1);
+    }
     arrow->invisible = FALSE;
 }
 
