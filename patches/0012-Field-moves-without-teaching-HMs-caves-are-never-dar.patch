From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mckenna654 <mckenna654@gmail.com>
Date: Tue, 24 Nov 2026 19:10:04 +1100
Subject: Field moves without teaching HMs; caves are never dark

On the Little and Junior presets Cut, Surf, Strength, Rock Smash and
Waterfall work as soon as the player owns the HM (badge checks unchanged):
the first Pokemon in the party performs the move. Flash is not needed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/include/little_trainers.h b/include/little_trainers.h
index d02e138b6..69e9a85cd 100644
--- a/include/little_trainers.h
+++ b/include/little_trainers.h
@@ -48,6 +48,8 @@ struct LtRules
 
     // Exploring
     u8 encounterRatePercent;    // how often wild Pokemon appear (100 = original)
+    bool8 hmFree;               // Cut, Surf, Strength, Rock Smash and Waterfall work as soon as the
+                                // player owns the HM (no need to teach it); caves are never dark
 
     // Opponent trainers: the most Pokemon a team may bring (6 = original teams)
     u8 trainerPartyCap;         // ordinary trainers
@@ -123,6 +125,9 @@ void LT_DrawStartMenuIcon(u8 windowId, u8 startMenuItem, u8 y);
 // 8x8 heart tile for one slice of the HP bar with 0-8 of its pixels filled.
 const u8 *LT_HeartTile(u8 filledPixels);
 
+// True if the player may use this HM move in the field without a Pokemon knowing it.
+bool32 LT_CanUseFieldMove(u16 move);
+
 // How many Pokemon the given trainer brings under the active preset.
 u8 LT_TrainerPartyCap(u16 trainerNum);
 
diff --git a/src/field_player_avatar.c b/src/field_player_avatar.c
index ef086dda3..972ed9dc5 100644
--- a/src/field_player_avatar.c
+++ b/src/field_player_avatar.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "little_trainers.h"
 #include "gflib.h"
 #include "bike.h"
 #include "event_data.h"
@@ -1194,6 +1195,9 @@ bool8 PartyHasMonWithSurf(void)
             if (MonKnowsMove(&gPlayerParty[i], MOVE_SURF))
                 return TRUE;
         }
+        // Little Trainers: owning the Surf HM is enough
+        if (LT_CanUseFieldMove(MOVE_SURF) && GetMonData(&gPlayerParty[0], MON_DATA_SPECIES) != SPECIES_NONE)
+            return TRUE;
     }
     return FALSE;
 }
