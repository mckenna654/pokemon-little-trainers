@@ -373,6 +376,36 @@ u8 LT_RecommendedAttack(u8 battler, u8 basicSlot, u8 specialSlot)
     return LT_MENU_SPECIAL;
 }
 
+bool32 LT_CanUseFieldMove(u16 move)
+{
+    u16 hm;
+
+    if (!LT_Rules()->hmFree)
+        return FALSE;
+
+    switch (move)
+    {
+    case MOVE_CUT:
+        hm = ITEM_HM01_CUT;
+        break;
+    case MOVE_SURF:
+        hm = ITEM_HM03_SURF;
+        break;
+    case MOVE_STRENGTH:
+        hm = ITEM_HM04_STRENGTH;
+        break;
+    case MOVE_ROCK_SMASH:
+        hm = ITEM_HM06_ROCK_SMASH;
+        break;
+    case MOVE_WATERFALL:
+        hm = ITEM_HM07_WATERFALL;
+        break;
+    default:
+        return FALSE;
+    }
+    return CheckBagHasItem(hm, 1);
+}
+
 u8 LT_TrainerPartyCap(u16 trainerNum)
 {
     const struct LtRules *rules = LT_Rules();
diff --git a/src/overworld.c b/src/overworld.c
index 542510943..5330d61f4 100644
--- a/src/overworld.c
+++ b/src/overworld.c
@@ -958,6 +958,11 @@ bool32 Overworld_IsBikingAllowed(void)
 
 static void SetDefaultFlashLevel(void)
 {
+    if (LT_Rules()->hmFree)
+    {
+        gSaveBlock1Ptr->flashLevel = 0; // Little Trainers: caves are never dark, no Flash needed
+        return;
+    }
     if (!gMapHeader.cave)
         gSaveBlock1Ptr->flashLevel = 0;
     else if (FlagGet(FLAG_SYS_FLASH_ACTIVE))
diff --git a/src/scrcmd.c b/src/scrcmd.c
index 97b695ee2..e3c27510d 100644
--- a/src/scrcmd.c
+++ b/src/scrcmd.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "little_trainers.h"
 #include "gflib.h"
 #include "script.h"
 #include "mystery_event_script.h"
@@ -1792,6 +1793,24 @@ bool8 ScrCmd_checkpartymove(struct ScriptContext * ctx)
             break;
         }
     }
+
+    // Little Trainers: field moves work once the player owns the HM, without teaching it.
+    // The first Pokemon in the party performs the move. Badge checks stay in the scripts.
+    if (gSpecialVar_Result == PARTY_SIZE && LT_CanUseFieldMove(moveId))
+    {
+        for (i = 0; i < PARTY_SIZE; i++)
+        {
+            u16 species = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL);
+            if (!species)
+                break;
+            if (!GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG))
+            {
+                gSpecialVar_Result = i;
+                gSpecialVar_0x8004 = species;
+                break;
+            }
+        }
+    }
     return FALSE;
 }
 
