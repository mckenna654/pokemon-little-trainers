     FillWindowPixelBuffer(MENU_WINDOW, PIXEL_FILL(COLOR_PANEL));
     for (slot = 0; slot < count; slot++)
-        DrawButton(battler, slot, slot == gActionSelectionCursor[battler]);
+    {
