     }
 }
 
+// With a single attack to offer, ATTACK and SPECIAL would be two buttons for the same move:
+// only ATTACK is shown.
+static bool32 SlotShown(u8 slot)
+{
+    if (slot == LT_MENU_SPECIAL)
+        return sBasicSlot != sSpecialSlot;
+    return slot < LT_BattleMenu_ButtonCount();
+}
+
+static u8 SlotPosition(u8 slot)
+{
+    u8 i;
+    u8 position = 0;
+
+    for (i = 0; i < slot; i++)
+    {
+        if (SlotShown(i))
+            position++;
+    }
+    return position;
+}
+
 static void DrawButton(u8 battler, u8 slot, bool32 selected)
 {
-    u16 x = BUTTON_X(slot);
+    u16 x = BUTTON_X(SlotPosition(slot));
 
     FillWindowPixelRect(MENU_WINDOW, PIXEL_FILL(COLOR_PANEL), x, 0, BUTTON_SIZE, BUTTON_SIZE);
     BlitBitmapToWindow(MENU_WINDOW, &sIconsGfx[ButtonIcon(battler, slot) * BUTTON_BYTES], x, 0, BUTTON_SIZE, BUTTON_SIZE);
@@ -287,7 +313,7 @@ void LT_BattleMenu_Show(u8 battler)
