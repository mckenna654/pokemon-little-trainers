diff --git a/src/battle_main.c b/src/battle_main.c
index 61da14768..d2b9b12e2 100644
--- a/src/battle_main.c
+++ b/src/battle_main.c
@@ -2279,6 +2279,10 @@ static void BattleStartClearSetData(void)
         gHitMarker |= HITMARKER_NO_ANIMATIONS;
 
     gBattleScripting.battleStyle = gSaveBlock2Ptr->optionsBattleStyle;
+    // Little Trainers: never ask "Will you switch POKeMON?" after an opponent's Pokemon is beaten.
+    // (A child pressing A would be taken into the party screen in the middle of every trainer battle.)
