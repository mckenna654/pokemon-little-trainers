+// Little Trainers: after a Rare Candy, a Pokemon with a full move list swaps the new move in for
+// its weakest one (or skips it) without asking which move to forget, as it does in battle.
+static bool32 LtAutoLearnMove(u8 taskId)
+{
+    struct Pokemon *mon = &gPlayerParty[gPartyMenu.slotId];
+    u8 slot;
+
+    if (!LT_Rules()->autoLearnMoves)
+        return FALSE;
+
+    slot = LT_ChooseMoveSlotToReplace(mon, gMoveToLearn);
+    if (slot == MAX_MON_MOVES)
+    {
+        gTasks[taskId].func = Task_TryLearningNextMove; // not worth learning: look for another
+    }
+    else
+    {
+        RemoveMonPPBonus(mon, slot);
+        SetMonMoveSlot(mon, gMoveToLearn, slot);
+        DisplayMonLearnedMove(taskId, gMoveToLearn);
+    }
+    return TRUE;
+}
