+static const union AnimCmd sConfettiAnim1[] = {ANIMCMD_FRAME(1, 1), ANIMCMD_END};
+static const union AnimCmd sConfettiAnim2[] = {ANIMCMD_FRAME(2, 1), ANIMCMD_END};
+static const union AnimCmd sConfettiAnim3[] = {ANIMCMD_FRAME(3, 1), ANIMCMD_END};
