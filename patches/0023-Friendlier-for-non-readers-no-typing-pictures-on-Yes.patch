                                 // freeze, paralysis and confusion (a permanent Safeguard)
@@ -169,4 +174,7 @@ u8 LT_TrainerPartyCap(u16 trainerNum);
 // Scales damage for the attacker's side according to the active preset.
 s32 LT_ScaleDamage(s32 damage, u8 battlerAttacker);
 
+void LT_DrawYesNoIcons(u8 windowId, u8 top, u8 rowHeight);
+bool32 LT_AnswersNoWithoutAsking(const u8 *text);
+
 #endif // GUARD_LITTLE_TRAINERS_H
