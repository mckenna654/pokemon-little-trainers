+#define sFallSpeed  data[0]     // pixels per frame, in 1/16ths
+#define sFallFrac   data[1]
+#define sSwayPhase  data[2]
+#define sStartX     data[3]
+
+static void SpriteCB_Confetti(struct Sprite *sprite)
+{
+    sprite->sFallFrac += sprite->sFallSpeed;
+    sprite->y += sprite->sFallFrac >> 4;
+    sprite->sFallFrac &= 0xF;
+    sprite->sSwayPhase = (sprite->sSwayPhase + 5) & 0xFF;
+    sprite->x = sprite->sStartX + (gSineTable[sprite->sSwayPhase] >> 5);
+    if (sprite->y > DISPLAY_HEIGHT + 8)
+        DestroySprite(sprite);
+}
+
+static const struct SpriteTemplate sConfettiTemplate =
+{
+    .tileTag = TAG_LT_CONFETTI,
+    .paletteTag = TAG_NONE,
+    .oam = &sConfettiOam,
+    .anims = sConfettiAnims,
+    .images = NULL,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCB_Confetti,
+};
