+static u8 CountBadges(void)
+{
+    u8 count = 0;
+    u16 flag;
+
+    for (flag = FLAG_BADGE01_GET; flag < FLAG_BADGE01_GET + NUM_BADGES; flag++)
+    {
+        if (FlagGet(flag))
+            count++;
+    }
+    return count;
+}
+
+static void UpdateBadgeCelebration(void)
+{
+    u8 badgesPlus1 = CountBadges() + 1;
+
+    // (fewer badges than last time means another game was started or loaded: just take note)
+    if (sBadgesPlus1 != 0 && badgesPlus1 > sBadgesPlus1 && LT_Rules()->badgeCelebration)
+        sConfettiTimer = CONFETTI_FRAMES;
+    sBadgesPlus1 = badgesPlus1;
+
+    if (sConfettiTimer == 0)
+        return;
+    sConfettiTimer--;
+    if (sConfettiTimer % 3 == 0)
+    {
+        u8 spriteId;
+        u16 random = Random();
+
+        if (GetSpriteTileStartByTag(TAG_LT_CONFETTI) == 0xFFFF)
+            LoadSpriteSheet(&sConfettiSheet);
+        spriteId = CreateSprite(&sConfettiTemplate, 8 + random % (DISPLAY_WIDTH - 16), -8, 0);
+        if (spriteId < MAX_SPRITES)
+        {
+            struct Sprite *sprite = &gSprites[spriteId];
+
+            sprite->oam.paletteNum = gSprites[gPlayerAvatar.spriteId].oam.paletteNum;
+            sprite->sStartX = sprite->x;
+            sprite->sFallSpeed = 20 + ((random >> 8) & 0x1F);
+            sprite->sSwayPhase = random >> 4;
+            StartSpriteAnim(sprite, (random >> 13) & 3);
+        }
+    }
+}
