+bool32 LT_StartMenuIconsActive(u8 numItems)
+{
+    return LT_Rules()->menuIcons && numItems <= LT_START_MENU_MAX_ICON_ROWS;
+}
+
+// Icons are 16x16 cells in the order of the STARTMENU_* enum, drawn with colours that every
+// field menu window already has, so they need no palette of their own.
+void LT_DrawStartMenuIcon(u8 windowId, u8 startMenuItem, u8 y)
+{
+    BlitBitmapToWindow(windowId, &sStartMenuIconsGfx[startMenuItem * (16 * 16 / 2)], 9, y, 16, 16);
+}
