 }
@@ -280,7 +283,18 @@ static s8 PrintStartMenuItems(s8 *cursor_p, u8 nitems)
     s16 i = *cursor_p;
     do
     {
-        if (sStartMenuOrder[i] == STARTMENU_PLAYER || sStartMenuOrder[i] == STARTMENU_PLAYER2)
+        if (LT_StartMenuIconsActive(sNumStartMenuItems))
+        {
+            // Little Trainers: a picture first, then the word (in the small font if it would not fit)
+            u8 font = FONT_NORMAL;
+
+            LT_DrawStartMenuIcon(GetStartMenuWindowId(), sStartMenuOrder[i], i * 15);
+            StringExpandPlaceholders(gStringVar4, sStartMenuActionTable[sStartMenuOrder[i]].text);
+            if (GetStringWidth(font, gStringVar4, 0) > 8 * 8 - LT_START_MENU_TEXT_X)
+                font = FONT_SMALL;
+            AddTextPrinterParameterized(GetStartMenuWindowId(), font, gStringVar4, LT_START_MENU_TEXT_X, i * 15, 0xFF, NULL);
+        }
+        else if (sStartMenuOrder[i] == STARTMENU_PLAYER || sStartMenuOrder[i] == STARTMENU_PLAYER2)
         {
             Menu_PrintFormatIntlPlayerName(GetStartMenuWindowId(), sStartMenuActionTable[sStartMenuOrder[i]].text, 8, i * 15);
         }
