diff --git a/src/new_menu_helpers.c b/src/new_menu_helpers.c
index 08c032027..38b09497c 100644
--- a/src/new_menu_helpers.c
+++ b/src/new_menu_helpers.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "little_trainers.h"
 #include "gflib.h"
 #include "help_message.h"
 #include "menu.h"
@@ -668,6 +669,11 @@ u8 CreateStartMenuWindow(u8 height)
     if (sStartMenuWindowId == 0xFF)
     {
         struct WindowTemplate template = SetWindowTemplateFields(0, 0x16, 1, 7, height * 2 - 1, DLG_WINDOW_PALETTE_NUM, 0x13D);
+
+        // Little Trainers: one tile wider to make room for a picture beside each entry. The menu
+        // has 91 tiles of VRAM; 8 wide x 11 high (six entries) uses 88.
+        if (LT_StartMenuIconsActive(height))
+            template = SetWindowTemplateFields(0, 0x15, 1, 8, height * 2 - 1, DLG_WINDOW_PALETTE_NUM, 0x13D);
         sStartMenuWindowId = AddWindow(&template);
         PutWindowTilemap(sStartMenuWindowId);
     }
