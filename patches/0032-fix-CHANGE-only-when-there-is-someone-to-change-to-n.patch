-#define MENU_WINDOW     B_WIN_LT_MENU       // 224x32 pixels: the whole inside of the message box
+#define MENU_WINDOW     B_WIN_MSG           // 224x32 pixels: the whole inside of the message box
 #define MENU_PALETTE    7
 #define BUTTON_SIZE     32
 #define BUTTON_BYTES    (BUTTON_SIZE * BUTTON_SIZE / 2)
@@ -76,6 +77,7 @@ static EWRAM_DATA u8 sBasicSlot = 0;
 static EWRAM_DATA u8 sSpecialSlot = 0;
