-// With a single attack to offer, ATTACK and SPECIAL would be two buttons for the same move:
-// only ATTACK is shown.
+// Is there a Pokemon in the party that CHANGE could bring in?
+static bool32 SomeoneToChangeTo(void)
+{
+    u8 i, battler;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+
+        if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG)
+         || GetMonData(mon, MON_DATA_HP) == 0)
+            continue;
+        for (battler = 0; battler < gBattlersCount; battler++)
+        {
+            if (GetBattlerSide(battler) == B_SIDE_PLAYER && gBattlerPartyIndexes[battler] == i)
+                break;
+        }
+        if (battler == gBattlersCount)
+            return TRUE; // not in the battle already
+    }
+    return FALSE;
+}
+
+// A button is only shown when it does something of its own:
+// - with a single attack to offer, ATTACK and SPECIAL would be two buttons for the same move;
+// - with nobody to change to, CHANGE would open a list where no choice works.
 static bool32 SlotShown(u8 slot)
 {
     if (slot == LT_MENU_SPECIAL)
         return sBasicSlot != sSpecialSlot;
+    if (slot == LT_MENU_CATCH_OR_CHANGE && (gBattleTypeFlags & BATTLE_TYPE_TRAINER))
+        return sSomeoneToChangeTo;
     return slot < LT_BattleMenu_ButtonCount();
 }
 
@@ -305,6 +333,7 @@ void LT_BattleMenu_Show(u8 battler)
 
     LT_ChooseAttackSlots(battler, &sBasicSlot, &sSpecialSlot);
     sRecommended = LT_RecommendedAttack(battler, sBasicSlot, sSpecialSlot);
+    sSomeoneToChangeTo = SomeoneToChangeTo();
 
     // The first time the menu opens in a battle the cursor starts on the recommended attack,
     // so simply pressing A does something sensible. After that it stays where the player left it.
@@ -327,7 +356,8 @@ void LT_BattleMenu_Show(u8 battler)
             DrawButton(battler, slot, slot == gActionSelectionCursor[battler]);
     }
     DrawLabel(battler, gActionSelectionCursor[battler]);
-    PutWindowTilemap(MENU_WINDOW);
+    PutWindowRectTilemapOverridePalette(MENU_WINDOW, 0, 0, GetWindowAttribute(MENU_WINDOW, WINDOW_WIDTH),
+                                        GetWindowAttribute(MENU_WINDOW, WINDOW_HEIGHT), MENU_PALETTE);
     CopyWindowToVram(MENU_WINDOW, COPYWIN_FULL);
 }
 
@@ -367,6 +397,7 @@ void LT_BattleMenu_Tick(void)
 
 void LT_BattleMenu_Hide(void)
 {
-    // Redrawing the (empty) message window puts its own tiles and palette back.
+    // Redrawing the (empty) message window clears the buttons and puts its own palette back
+    // on its tiles.
     BattlePutTextOnWindow(gText_EmptyString3, B_WIN_MSG);
 }
