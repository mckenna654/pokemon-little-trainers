+bool32 LT_SimpleBattleMenuActive(void)
+{
+    if (!LT_BattleRulesActive() || !LT_Rules()->simpleBattleMenu)
+        return FALSE;
+    // Tutorial and Safari battles have their own menus and controllers.
+    if (gBattleTypeFlags & (BATTLE_TYPE_SAFARI | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_OLD_MAN_TUTORIAL | BATTLE_TYPE_FIRST_BATTLE))
+        return FALSE;
+    return TRUE;
+}
+
+#define LT_FALLBACK_MOVE MOVE_TACKLE
+
+void LT_ChooseAttackSlots(u8 battler, u8 *basicSlot, u8 *specialSlot)
+{
+    struct BattlePokemon *mon = &gBattleMons[battler];
+    u8 unusable = CheckMoveLimitations(battler, 0, MOVE_LIMITATIONS_ALL);
+    u16 scores[MAX_MON_MOVES];
+    u16 best;
+    u8 i;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (unusable & gBitTable[i])
+            scores[i] = 0;
+        else
+            scores[i] = LT_MoveScore(mon->moves[i]);
+    }
+
+    // SPECIAL: the strongest move, favouring the Pokemon's own type and anything more
+    // exciting than a Normal-type move.
+    *specialSlot = MAX_MON_MOVES;
+    best = 0;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 score = scores[i];
+        u8 type = gBattleMoves[mon->moves[i]].type;
+
+        if (score == 0)
+            continue;
+        if (type == mon->type1 || type == mon->type2)
+            score = score * 3 / 2;
+        if (type != TYPE_NORMAL)
+            score += 20;
+        if (score > best)
+        {
+            best = score;
+            *specialSlot = i;
+        }
+    }
+
+    if (*specialSlot == MAX_MON_MOVES)
+    {
+        // No usable attack at all (for example only Harden or Splash): borrow a basic attack
+        // for this battle. Marking the slot like a Mimic copy keeps the engine from ever
+        // writing it back to the Pokemon's real move list.
+        u8 slot = MAX_MON_MOVES - 1;
+
+        for (i = 0; i < MAX_MON_MOVES; i++)
+        {
+            if (mon->moves[i] == MOVE_NONE)
+            {
+                slot = i;
+                break;
+            }
+        }
+        mon->moves[slot] = LT_FALLBACK_MOVE;
+        mon->pp[slot] = gBattleMoves[LT_FALLBACK_MOVE].pp;
+        gDisableStructs[battler].mimickedMoves |= gBitTable[slot];
+        *basicSlot = *specialSlot = slot;
+        return;
+    }
+
+    // ATTACK: the best of the remaining moves; the same move if there is only one.
+    *basicSlot = *specialSlot;
+    best = 0;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (i != *specialSlot && scores[i] > best)
+        {
+            best = scores[i];
+            *basicSlot = i;
+        }
+    }
+}
