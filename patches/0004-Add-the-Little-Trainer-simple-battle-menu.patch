+// Little Trainers: input for the simple battle menu (ATTACK / CATCH or CHANGE / SPECIAL / RUN).
+// Every choice is a single press: no move list, no bag. B does nothing, so mashing is safe.
+static void LtHandleInputSimpleMenu(void)
+{
+    bool32 trainerBattle = (gBattleTypeFlags & BATTLE_TYPE_TRAINER) != 0;
+    u8 cursor = gActionSelectionCursor[gActiveBattler];
+    u8 newCursor = cursor;
+
+    if (JOY_NEW(A_BUTTON))
+    {
+        switch (cursor)
+        {
+        case LT_MENU_ATTACK:
+        case LT_MENU_SPECIAL:
+            PlaySE(SE_SELECT);
+            BtlController_EmitTwoReturnValues(1, B_ACTION_USE_MOVE, 0);
+            break;
+        case LT_MENU_CATCH_OR_CHANGE:
+            if (trainerBattle)
+            {
+                PlaySE(SE_SELECT);
+                BtlController_EmitTwoReturnValues(1, B_ACTION_SWITCH, 0);
+            }
+            else if (IsPlayerPartyAndPokemonStorageFull())
+            {
+                PlaySE(SE_FAILURE); // nowhere to put another Pokemon
+                return;
+            }
+            else
+            {
+                PlaySE(SE_SELECT);
+                BtlController_EmitTwoReturnValues(1, B_ACTION_USE_ITEM, 0);
+            }
+            break;
+        default: // LT_MENU_RUN
+            PlaySE(SE_SELECT);
+            BtlController_EmitTwoReturnValues(1, B_ACTION_RUN, 0);
+            break;
+        }
+        PlayerBufferExecCompleted();
+        return;
+    }
+
+    if (JOY_NEW(DPAD_LEFT) && (cursor & 1))
+        newCursor ^= 1;
+    else if (JOY_NEW(DPAD_RIGHT) && !(cursor & 1))
+        newCursor ^= 1;
+    else if (JOY_NEW(DPAD_UP) && (cursor & 2))
+        newCursor ^= 2;
+    else if (JOY_NEW(DPAD_DOWN) && !(cursor & 2))
+        newCursor ^= 2;
+
+    if (trainerBattle && newCursor == LT_MENU_RUN)
+        newCursor = cursor; // there is no RUN entry against trainers
+
+    if (newCursor != cursor)
+    {
+        PlaySE(SE_SELECT);
+        ActionSelectionDestroyCursorAt(cursor);
+        gActionSelectionCursor[gActiveBattler] = newCursor;
+        ActionSelectionCreateCursorAt(newCursor, 0);
+    }
+}
