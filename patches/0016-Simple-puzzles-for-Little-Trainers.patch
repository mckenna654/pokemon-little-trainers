+void LT_OpenPuzzleGates(void)
+{
+    u16 flag;
+
+    if (!LT_Rules()->simplePuzzles)
+        return;
+
+    // Lt. Surge's gym: the electric gates are off (normally: find two hidden switches in bins)
+    FlagSet(FLAG_FOUND_BOTH_VERMILION_GYM_SWITCHES);
+    // Cinnabar Gym is unlocked (normally: find the Secret Key deep in the Pokemon Mansion)
+    FlagSet(FLAG_HIDE_POKEMON_MANSION_B1F_SECRET_KEY);
+    // Victory Road: the rock barriers are down (normally: push boulders onto switches)
+    VarSet(VAR_MAP_SCENE_VICTORY_ROAD_1F, 100);
+    VarSet(VAR_MAP_SCENE_VICTORY_ROAD_2F_BOULDER1, 100);
+    VarSet(VAR_MAP_SCENE_VICTORY_ROAD_2F_BOULDER2, 100);
+    VarSet(VAR_MAP_SCENE_VICTORY_ROAD_3F, 100);
+    // Silph Co.: every Card Key door is open
+    for (flag = FLAG_SILPH_2F_DOOR_1; flag <= FLAG_SILPH_11F_DOOR; flag++)
+        FlagSet(flag);
+}
