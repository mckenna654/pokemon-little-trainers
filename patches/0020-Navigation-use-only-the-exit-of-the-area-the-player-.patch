+// Seeds the fill with what to walk to. The route table lists one exit for each separate area of
+// the map, so only the exit of the area the player is standing in is used: otherwise a one-way
+// ledge could pull the path towards another area's exit. If the goal itself is in reach, that
+// wins; if nothing listed is in the player's area (the way on starts with a ledge hop), every
+// listed exit is used.
+static void SeedGoals(struct Fill *fill, const struct LtNavGoal *goal)
+{
+    const u8 *exits = NULL;
+    s32 goalX, goalY;
+    bool32 hasGoal = GoalTile(goal, &goalX, &goalY);
+    u8 qualified = 0;      // bit i: exit i is in the player's area (up to 8 are checked)
+    u8 count = 0;
+    u8 i;
+
+    if (gSaveBlock1Ptr->location.mapGroup < ARRAY_COUNT(sLtNavGroupStart))
+    {
+        u16 mapIndex = sLtNavGroupStart[gSaveBlock1Ptr->location.mapGroup] + gSaveBlock1Ptr->location.mapNum;
+
+        if (mapIndex < LT_NAV_NUM_MAPS)
+        {
+            exits = &sLtNavExits[sLtNavRoutes[goal->route][mapIndex]];
+            count = *exits++;
+        }
+    }
+
+    MarkPlayerArea(fill);
+    if (hasGoal && NearPlayerArea(fill, goalX, goalY))
+    {
+        count = 0; // the goal is right here: nothing else matters
+    }
+    else
+    {
+        for (i = 0; i < count && i < 8; i++)
+        {
+            if (ExitInPlayerArea(fill, exits[i * 3], exits[i * 3 + 1], exits[i * 3 + 2]))
+                qualified |= 1 << i;
+        }
+    }
+
+    // wipe the area marks before the real fill
+    {
+        u32 n = fill->width * fill->height;
+        u32 j;
+
+        for (j = 0; j < n; j++)
+        {
+            if (sField[j] == FIELD_AREA)
+                sField[j] = FIELD_UNVISITED;
+        }
+    }
+    fill->head = 0;
+    fill->count = 0;
+
+    if (hasGoal)
+        FillPush(fill, goalX, goalY, FIELD_GOAL);
+    for (i = 0; i < count; i++)
+    {
+        if (qualified == 0 || (i < 8 && (qualified & (1 << i))))
+            SeedExit(fill, exits[i * 3], exits[i * 3 + 1], exits[i * 3 + 2]);
+    }
 }
 
