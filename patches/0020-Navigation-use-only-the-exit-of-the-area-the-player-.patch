+// FireRed-only wild Pokemon and the LeafGreen-only Pokemon found in the same places.
+static const u16 sVersionCounterparts[][2] =
+{
+    {SPECIES_EKANS,      SPECIES_SANDSHREW},
+    {SPECIES_ARBOK,      SPECIES_SANDSLASH},
+    {SPECIES_ODDISH,     SPECIES_BELLSPROUT},
+    {SPECIES_GLOOM,      SPECIES_WEEPINBELL},
+    {SPECIES_GROWLITHE,  SPECIES_VULPIX},
+    {SPECIES_PSYDUCK,    SPECIES_SLOWPOKE},
+    {SPECIES_GOLDUCK,    SPECIES_SLOWBRO},
+    {SPECIES_SHELLDER,   SPECIES_STARYU},
+    {SPECIES_ELECTABUZZ, SPECIES_MAGMAR},
+    {SPECIES_SCYTHER,    SPECIES_PINSIR},
+    {SPECIES_MANKEY,     SPECIES_MEOWTH},
+};
+
+u16 LT_MaybeSwapVersionExclusive(u16 species)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sVersionCounterparts); i++)
+    {
+        if (sVersionCounterparts[i][0] == species)
+        {
+            if (Random() % 100 < LT_Rules()->versionExclusivePercent)
+                return sVersionCounterparts[i][1];
+            break;
+        }
+    }
+    return species;
+}
