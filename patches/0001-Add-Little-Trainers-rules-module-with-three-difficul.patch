diff --git a/src/little_trainers.c b/src/little_trainers.c
new file mode 100644
index 000000000..e4d40852e
--- /dev/null
+++ b/src/little_trainers.c
@@ -0,0 +1,211 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "event_data.h"
+#include "item.h"
+#include "little_trainers.h"
+#include "pokemon.h"
+#include "constants/battle_move_effects.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+
+// Pokemon: Little Trainers - rule tables and helpers. See include/little_trainers.h.
+
+static const struct LtRules sRules[LT_DIFFICULTY_COUNT] =
+{
+    [LT_DIFFICULTY_LITTLE] =
+    {
+        .guaranteedCatch = TRUE,
+        .freeBalls = TRUE,
+        .catchRatePercent = 100,
+        .healAfterBattle = TRUE,
+        .noLossPenalty = TRUE,
+        .expPercent = 250,
+        .benchExpPercent = 50,
+        .infinitePP = TRUE,
+        .playerNeverMisses = TRUE,
+        .enemyNoCrits = TRUE,
+        .playerDamagePercent = 150,
+        .enemyDamagePercent = 60,
+        .autoLearnMoves = TRUE,
+    },
+    [LT_DIFFICULTY_JUNIOR] =
+    {
+        .guaranteedCatch = FALSE,
+        .freeBalls = TRUE,
+        .catchRatePercent = 250,
+        .healAfterBattle = TRUE,
+        .noLossPenalty = TRUE,
+        .expPercent = 150,
+        .benchExpPercent = 50,
+        .infinitePP = FALSE,
+        .playerNeverMisses = FALSE,
+        .enemyNoCrits = TRUE,
+        .playerDamagePercent = 120,
+        .enemyDamagePercent = 80,
+        .autoLearnMoves = FALSE,
+    },
+    [LT_DIFFICULTY_CLASSIC] =
+    {
+        .guaranteedCatch = FALSE,
+        .freeBalls = FALSE,
+        .catchRatePercent = 100,
+        .healAfterBattle = FALSE,
+        .noLossPenalty = FALSE,
+        .expPercent = 100,
+        .benchExpPercent = 0,
+        .infinitePP = FALSE,
+        .playerNeverMisses = FALSE,
+        .enemyNoCrits = FALSE,
+        .playerDamagePercent = 100,
+        .enemyDamagePercent = 100,
+        .autoLearnMoves = FALSE,
+    },
+};
+
+u8 LT_GetDifficulty(void)
+{
+    u16 difficulty = VarGet(VAR_LT_DIFFICULTY);
+
+    if (difficulty >= LT_DIFFICULTY_COUNT)
+        difficulty = LT_DIFFICULTY_LITTLE; // unknown value (e.g. a newer save): fall back to the safest preset
+    return difficulty;
+}
+
+void LT_SetDifficulty(u8 difficulty)
+{
+    if (difficulty < LT_DIFFICULTY_COUNT)
+        VarSet(VAR_LT_DIFFICULTY, difficulty);
+}
+
+const struct LtRules *LT_Rules(void)
+{
+    return &sRules[LT_GetDifficulty()];
+}
+
+bool32 LT_BattleRulesActive(void)
+{
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK
+                          | BATTLE_TYPE_BATTLE_TOWER
+                          | BATTLE_TYPE_TRAINER_TOWER
+                          | BATTLE_TYPE_EREADER_TRAINER))
+        return FALSE;
+    return TRUE;
+}
+
+void LT_OnBattleStart(void)
+{
+    if (!LT_BattleRulesActive())
+        return;
+
+    // Free balls: make sure there is always a Poke Ball to throw. It is never used up
+    // (see BattleUseFunc_PokeBallEtc), so the count cannot run away or underflow.
+    if (LT_Rules()->freeBalls
+     && !(gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_SAFARI | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_OLD_MAN_TUTORIAL))
+     && !CheckBagHasItem(ITEM_POKE_BALL, 1))
+        AddBagItem(ITEM_POKE_BALL, 1);
+}
+
+u16 LT_MoveScore(u16 move)
+{
+    const struct BattleMove *info;
+    u16 accuracy;
+
+    if (move == MOVE_NONE || move >= MOVES_COUNT || move == MOVE_STRUGGLE)
+        return 0;
+
+    info = &gBattleMoves[move];
+    if (info->power <= 1) // status moves (0) and variable-power moves (1)
+        return 0;
+
+    switch (info->effect)
+    {
+    // hurts or removes the user
+    case EFFECT_EXPLOSION:
+    case EFFECT_RECOIL:
+    case EFFECT_DOUBLE_EDGE:
+    case EFFECT_RECOIL_IF_MISS:
+    case EFFECT_MEMENTO:
+    case EFFECT_OVERHEAT:
+    case EFFECT_SUPERPOWER:
+    // needs a turn to charge, recharge or hide, or locks the user in
+    case EFFECT_RECHARGE:
+    case EFFECT_RAZOR_WIND:
+    case EFFECT_SKY_ATTACK:
+    case EFFECT_SKULL_BASH:
+    case EFFECT_SOLAR_BEAM:
+    case EFFECT_SEMI_INVULNERABLE:
+    case EFFECT_FOCUS_PUNCH:
+    case EFFECT_FUTURE_SIGHT:
+    case EFFECT_BIDE:
+    case EFFECT_RAMPAGE:
+    case EFFECT_UPROAR:
+    case EFFECT_ROLLOUT:
+    case EFFECT_FURY_CUTTER:
+    // only works in special situations
+    case EFFECT_DREAM_EATER:
+    case EFFECT_SNORE:
+    case EFFECT_FAKE_OUT:
+    case EFFECT_SPIT_UP:
+    case EFFECT_COUNTER:
+    case EFFECT_MIRROR_COAT:
+    case EFFECT_OHKO:
+    case EFFECT_FALSE_SWIPE:
+    case EFFECT_PRESENT:
+    case EFFECT_BEAT_UP:
+        return 0;
+    }
+
+    accuracy = info->accuracy;
+    if (accuracy == 0 || LT_Rules()->playerNeverMisses)
+        accuracy = 100;
+    return info->power * accuracy / 100 + 1;
+}
+
+u8 LT_ChooseMoveSlotToReplace(struct Pokemon *mon, u16 newMove)
+{
+    u16 newScore = LT_MoveScore(newMove);
+    u16 worstScore = 0xFFFF;
+    u8 worstSlot = MAX_MON_MOVES;
+    u8 i;
+
+    if (newScore == 0)
+        return MAX_MON_MOVES; // nothing a young player would use: keep the current moves
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        u16 score;
+
+        if (IsHMMove2(move))
+            continue; // HM moves cannot be forgotten
+        score = LT_MoveScore(move);
+        if (score < worstScore)
+        {
+            worstScore = score;
+            worstSlot = i;
+        }
+    }
+
+    if (worstSlot == MAX_MON_MOVES || newScore <= worstScore)
+        return MAX_MON_MOVES; // the new move is no better than what the Pokemon already has
+    return worstSlot;
+}
+
+s32 LT_ScaleDamage(s32 damage, u8 battlerAttacker)
+{
+    u8 percent;
+
+    if (!LT_BattleRulesActive() || damage <= 0)
+        return damage;
+
+    if (GetBattlerSide(battlerAttacker) == B_SIDE_PLAYER)
+        percent = LT_Rules()->playerDamagePercent;
+    else
+        percent = LT_Rules()->enemyDamagePercent;
+
+    damage = damage * percent / 100;
+    if (damage == 0)
+        damage = 1;
+    return damage;
+}
