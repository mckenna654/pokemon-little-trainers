From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mckenna654 <mckenna654@gmail.com>
Date: Tue, 24 Nov 2026 17:34:21 +1100
Subject: Add Little Trainers rules module with three difficulty presets

include/little_trainers.h and src/little_trainers.c hold every tunable rule
(catching, healing, experience, battle assists, move learning) per preset.
The preset is stored in the unused script variable 0x4029; a new game
defaults to Little Trainer.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>

diff --git a/include/little_trainers.h b/include/little_trainers.h
new file mode 100644
index 000000000..db63efd6f
--- /dev/null
+++ b/include/little_trainers.h
@@ -0,0 +1,70 @@
+#ifndef GUARD_LITTLE_TRAINERS_H
+#define GUARD_LITTLE_TRAINERS_H
+
+// Pokemon: Little Trainers - central rules for the preschool-friendly presets.
+//
+// Engine code never hard-codes Little Trainers behaviour. It asks this module, e.g.
+//     if (LT_Rules()->guaranteedCatch) ...
+// so every rule can be tuned or switched off here, per difficulty preset.
+
+enum
+{
+    LT_DIFFICULTY_LITTLE,   // ages 3-4, the default and the main target
+    LT_DIFFICULTY_JUNIOR,   // ages 5-6
+    LT_DIFFICULTY_CLASSIC,  // ages 7+, close to original FireRed rules
+    LT_DIFFICULTY_COUNT
+};
+
+// The chosen preset is kept in a script variable that FireRed never uses. Variables live in
+// SaveBlock1, so the choice is saved with the game and covered by the normal save checksums.
+// A new game starts with the variable at 0, which is LT_DIFFICULTY_LITTLE.
+#define VAR_LT_DIFFICULTY VAR_0x4029
+
+struct LtRules
+{
+    // Catching
+    bool8 guaranteedCatch;      // every ball thrown at a catchable wild Pokemon succeeds
+    bool8 freeBalls;            // Poke Balls are never used up and are always available
+    u8 catchRatePercent;        // scales catch odds when not guaranteed (100 = original)
+
+    // Recovery and losing
+    bool8 healAfterBattle;      // full party heal (HP, PP, status) when a battle ends
+    bool8 noLossPenalty;        // losing a battle never costs money
+
+    // Experience
+    u8 expPercent;              // experience gained, in percent of the original (250 = x2.5)
+    u8 benchExpPercent;         // share given to party members that did not battle (0 = original rules)
+
+    // Battles
+    bool8 infinitePP;           // the player's moves never run out of PP
+    bool8 playerNeverMisses;    // the player's damaging moves always hit
+    bool8 enemyNoCrits;         // opponents never land critical hits
+    u8 playerDamagePercent;     // damage dealt by the player's Pokemon (100 = original)
+    u8 enemyDamagePercent;      // damage dealt by opposing Pokemon (100 = original)
+
+    // Moves
+    bool8 autoLearnMoves;       // new moves replace the weakest one automatically, no prompts
+};
+
+u8 LT_GetDifficulty(void);
+void LT_SetDifficulty(u8 difficulty);
+const struct LtRules *LT_Rules(void);
+
+// True when Little Trainers battle rules apply to the current battle (never in link battles).
+bool32 LT_BattleRulesActive(void);
+
+// Called once when a battle is being set up.
+void LT_OnBattleStart(void);
+
+// How suitable a move is for a young player: 0 = never choose it (no damage, or a confusing or
+// self-harming effect), otherwise larger is better (roughly power x accuracy).
+u16 LT_MoveScore(u16 move);
+
+// Which move slot (0-3) a full move list should give up for newMove, or MAX_MON_MOVES to keep the
+// current moves and skip learning newMove.
+u8 LT_ChooseMoveSlotToReplace(struct Pokemon *mon, u16 newMove);
+
+// Scales damage for the attacker's side according to the active preset.
+s32 LT_ScaleDamage(s32 damage, u8 battlerAttacker);
+
+#endif // GUARD_LITTLE_TRAINERS_H
