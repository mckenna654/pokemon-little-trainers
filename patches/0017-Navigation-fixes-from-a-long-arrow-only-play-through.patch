+// Seeds everything worth walking to on this map: the goal itself if it is here, and the exit the
+// route table lists for each separate area of the map. Each listed exit belongs to one area, so
+// every area ends up pointing at its own way onward.
+static void SeedGoals(struct Fill *fill, const struct LtNavGoal *goal)
+{
+    const u8 *exits;
+    u16 mapIndex;
+    u8 i, count;
+
+    if (gSaveBlock1Ptr->location.mapGroup == goal->mapGroup
+     && gSaveBlock1Ptr->location.mapNum == goal->mapNum
+     && goal->x != 0xFF)
+        FillPush(fill, goal->x + MAP_OFFSET, goal->y + MAP_OFFSET, FIELD_GOAL);
+
+    if (gSaveBlock1Ptr->location.mapGroup >= ARRAY_COUNT(sLtNavGroupStart))
+        return;
+    mapIndex = sLtNavGroupStart[gSaveBlock1Ptr->location.mapGroup] + gSaveBlock1Ptr->location.mapNum;
+    if (mapIndex >= LT_NAV_NUM_MAPS)
+        return;
+    exits = &sLtNavExits[sLtNavRoutes[goal->route][mapIndex]];
+    count = *exits++;
+    for (i = 0; i < count; i++, exits += 3)
+        SeedExit(fill, exits[0], exits[1], exits[2]);
+}
