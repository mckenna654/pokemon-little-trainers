+static const u8 (*const sLtNavRoutes[])[LT_NAV_CANDIDATES] = {sLtNavRoute0, sLtNavRoute1, sLtNavRoute2, sLtNavRoute3, sLtNavRoute4, sLtNavRoute5, sLtNavRoute6, sLtNavRoute7, sLtNavRoute8, sLtNavRoute9, sLtNavRoute10, sLtNavRoute11, sLtNavRoute12, sLtNavRoute13, sLtNavRoute14, sLtNavRoute15, sLtNavRoute16, sLtNavRoute17, sLtNavRoute18, sLtNavRoute19, sLtNavRoute20, sLtNavRoute21, sLtNavRoute22};
+
+static const struct LtNavGoal sLtNavGoals[] = {
+    {1, 0x4050, 1, 3, 0, 12, 1, 0}, // leave_home: until VAR_MAP_SCENE_PALLET_TOWN_OAK >= 1
+    {0, 0x0828, 0, 4, 3, 9, 4, 1}, // choose_starter: until FLAG_SYS_POKEMON_GET
+    {1, 0x4055, 4, 4, 3, 6, 10, 1}, // first_battle: until VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB >= 4
+    {1, 0x4057, 1, 5, 3, 255, 255, 2}, // get_parcel: until VAR_MAP_SCENE_VIRIDIAN_CITY_MART >= 1
+    {0, 0x0829, 0, 4, 3, 6, 3, 1}, // deliver_parcel: until FLAG_SYS_POKEDEX_GET
+    {0, 0x0820, 0, 6, 2, 6, 5, 3}, // brock: until FLAG_BADGE01_GET
+    {0, 0x0821, 0, 7, 5, 8, 6, 4}, // misty: until FLAG_BADGE02_GET
+    {0, 0x0234, 0, 30, 0, 7, 5, 5}, // bill: until FLAG_GOT_SS_TICKET
+    {0, 0x0237, 0, 1, 11, 5, 4, 6}, // ss_anne: until FLAG_GOT_HM01
+    {0, 0x0822, 0, 9, 6, 5, 2, 7}, // lt_surge: until FLAG_BADGE03_GET
+    {0, 0x0823, 0, 10, 16, 6, 4, 8}, // erika: until FLAG_BADGE04_GET
+    {0, 0x0037, 0, 1, 45, 19, 4, 9}, // rocket_hideout: until FLAG_HIDE_SILPH_SCOPE
+    {0, 0x023c, 0, 1, 94, 11, 4, 10}, // pokemon_tower: until FLAG_RESCUED_MR_FUJI
+    {0, 0x023d, 0, 8, 2, 3, 3, 11}, // poke_flute: until FLAG_GOT_POKE_FLUTE
+    {0, 0x02a6, 0, 10, 7, 2, 9, 12}, // tea: until FLAG_GOT_TEA
+    {0, 0x003e, 0, 1, 57, 9, 9, 13}, // silph_co: until FLAG_HIDE_SAFFRON_ROCKETS
+    {0, 0x0825, 0, 14, 3, 14, 11, 14}, // sabrina: until FLAG_BADGE06_GET
+    {0, 0x0824, 0, 11, 3, 7, 13, 15}, // koga: until FLAG_BADGE05_GET
+    {0, 0x0239, 0, 1, 71, 255, 255, 16}, // safari_surf: until FLAG_GOT_HM03
+    {0, 0x0189, 0, 1, 66, 28, 14, 17}, // gold_teeth: until FLAG_HIDE_SAFARI_ZONE_WEST_GOLD_TEETH
+    {0, 0x023a, 0, 11, 7, 3, 5, 18}, // warden: until FLAG_GOT_HM04
+    {0, 0x01a8, 0, 1, 59, 255, 255, 19}, // secret_key: until FLAG_HIDE_POKEMON_MANSION_B1F_SECRET_KEY
