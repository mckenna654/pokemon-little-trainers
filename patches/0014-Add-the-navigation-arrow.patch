diff --git a/src/little_trainers_nav.c b/src/little_trainers_nav.c
new file mode 100644
index 000000000..634fe9b20
--- /dev/null
+++ b/src/little_trainers_nav.c
@@ -0,0 +1,614 @@
+#include "global.h"
+#include "gflib.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "little_trainers.h"
+#include "metatile_behavior.h"
+#include "overworld.h"
+#include "quest_log.h"
+#include "script.h"
+#include "constants/event_object_movement.h"
+#include "constants/event_objects.h"
+#include "constants/flags.h"
+#include "constants/moves.h"
+
+// Pokemon: Little Trainers - the "where do I go?" arrow.
+//
+// The story is a list of goals (talk to Brock, find Bill, ...). The current goal is the first one
+// that is not done yet. For every goal and every map the generated table says which door or map
+// edge leads towards it (tools/gen_nav.py works that out from the game's own map data). On the
+// current map this file finds a walkable path to that door, edge or person and shows an arrow
+// next to the player pointing along it. Nothing is forced: the player can ignore it and explore.
+
+struct LtNavGoal
+{
+    u8 condType;    // 0: done when flag condId is set; 1: done when var condId >= condValue
+    u16 condId;
+    u16 condValue;
+    u8 mapGroup;
+    u8 mapNum;
+    u8 x;           // 0xFF: anywhere on the map
+    u8 y;
+    u8 route;
+};
+
+#include "data/little_trainers_nav.h"
+
+#define NO_GOAL 0xFF
+
+// Values in the path field, one byte per map tile: the direction to walk from that tile.
+#define FIELD_UNVISITED 0
+// 1-4 are DIR_SOUTH, DIR_NORTH, DIR_WEST, DIR_EAST
+#define FIELD_GOAL      5
+#define FIELD_BLOCKED   0xF
+
+#define QUEUE_SIZE 2048     // ring buffer of tile indices for the flood fill
+
+static const s8 sDirDelta[][2] =
+{
+    [DIR_SOUTH] = { 0,  1},
+    [DIR_NORTH] = { 0, -1},
+    [DIR_WEST]  = {-1,  0},
+    [DIR_EAST]  = { 1,  0},
+};
+
+static EWRAM_DATA u8 *sField = NULL;        // on the heap; NULL after any heap reset
+static EWRAM_DATA u8 sBuiltGoal = NO_GOAL;
+static EWRAM_DATA u8 sBuiltMapGroup = 0;
+static EWRAM_DATA u8 sBuiltMapNum = 0;
+static EWRAM_DATA bool8 sBuiltCanSurf = FALSE;
+static EWRAM_DATA u8 sArrowSpriteId = MAX_SPRITES;
+static EWRAM_DATA u8 sBobTimer = 0;
+static EWRAM_DATA bool8 sAvoidEveryone = FALSE; // the last path ran into somebody: route around all people
+static EWRAM_DATA u8 sRetryTimer = 0;
+
+// ---------------------------------------------------------------------------------------------
+// Goals
+// ---------------------------------------------------------------------------------------------
+
+static bool32 GoalDone(const struct LtNavGoal *goal)
+{
+    if (goal->condType == 0)
+        return FlagGet(goal->condId);
+    return VarGet(goal->condId) >= goal->condValue;
+}
+
+static u8 CurrentGoal(void)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sLtNavGoals); i++)
+    {
+        if (!GoalDone(&sLtNavGoals[i]))
+            return i;
+    }
+    return NO_GOAL;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Path field: a flood fill outwards from the goal tiles, recording for every reachable tile which
+// way to step to get one tile closer. One-way ledges are followed in the direction they allow.
+// ---------------------------------------------------------------------------------------------
+
+static bool32 CanSurfNow(void)
+{
+    if (TestPlayerAvatarFlags(PLAYER_AVATAR_FLAG_SURFING))
+        return TRUE;
+    return FlagGet(FLAG_BADGE05_GET) && PartyHasMonWithSurf();
+}
+
+static bool32 TileWalkable(s32 x, s32 y, bool32 canSurf)
+{
+    if (MapGridGetCollisionAt(x, y))
+        return FALSE;
+    if (!canSurf && MetatileBehavior_IsSurfable(MapGridGetMetatileBehaviorAt(x, y)))
+        return FALSE;
+    return TRUE;
+}
+
+static bool32 IsLedgeInDirection(s32 x, s32 y, u8 dir)
+{
+    u8 behavior = MapGridGetMetatileBehaviorAt(x, y);
+
+    switch (dir)
+    {
+    case DIR_SOUTH:
+        return MetatileBehavior_IsJumpSouth(behavior);
+    case DIR_NORTH:
+        return MetatileBehavior_IsJumpNorth(behavior);
+    case DIR_WEST:
+        return MetatileBehavior_IsJumpWest(behavior);
+    default:
+        return MetatileBehavior_IsJumpEast(behavior);
+    }
+}
+
+struct Fill
+{
+    u16 *queue;
+    u16 head;
+    u16 count;
+    s32 width;
+    s32 height;
+    bool32 canSurf;
+};
+
+static void FillPush(struct Fill *fill, s32 x, s32 y, u8 value)
+{
+    if (x < 0 || y < 0 || x >= fill->width || y >= fill->height)
+        return;
+    sField[y * fill->width + x] = value;
+    if (fill->count < QUEUE_SIZE)
+    {
+        fill->queue[(fill->head + fill->count) % QUEUE_SIZE] = y * fill->width + x;
+        fill->count++;
+    }
+}
+
+static void FillRun(struct Fill *fill)
+{
+    while (fill->count != 0)
+    {
+        u16 index = fill->queue[fill->head];
+        s32 x = index % fill->width;
+        s32 y = index / fill->width;
+        u8 dir;
+
+        fill->head = (fill->head + 1) % QUEUE_SIZE;
+        fill->count--;
+
+        for (dir = DIR_SOUTH; dir <= DIR_EAST; dir++)
+        {
+            // (nx, ny) is the tile from which walking in `dir` arrives at (x, y)
+            s32 nx = x - sDirDelta[dir][0];
+            s32 ny = y - sDirDelta[dir][1];
+            u8 *cell;
+
+            if (nx < 0 || ny < 0 || nx >= fill->width || ny >= fill->height)
+                continue;
+            cell = &sField[ny * fill->width + nx];
+            if (*cell == FIELD_UNVISITED)
+            {
+                if (TileWalkable(nx, ny, fill->canSurf))
+                {
+                    FillPush(fill, nx, ny, dir);
+                    continue;
+                }
+                *cell = FIELD_BLOCKED;
+            }
+            if (*cell == FIELD_BLOCKED && IsLedgeInDirection(nx, ny, dir))
+            {
+                // hop over the ledge: the tile beyond it leads here too
+                s32 lx = nx - sDirDelta[dir][0];
+                s32 ly = ny - sDirDelta[dir][1];
+
+                if (lx >= 0 && ly >= 0 && lx < fill->width && ly < fill->height
+                 && sField[ly * fill->width + lx] == FIELD_UNVISITED
+                 && TileWalkable(lx, ly, fill->canSurf))
+                    FillPush(fill, lx, ly, dir);
+            }
+        }
+    }
+}
+
+// Seeds the fill with the tiles to aim for. candidate 0 on the goal's own map is the goal itself;
+// otherwise candidates are the exits the route table lists for this map.
+static bool32 SeedCandidate(struct Fill *fill, const struct LtNavGoal *goal, u8 candidate)
+{
+    bool32 onGoalMap = (gSaveBlock1Ptr->location.mapGroup == goal->mapGroup
+                     && gSaveBlock1Ptr->location.mapNum == goal->mapNum);
+    u16 mapIndex;
+    u8 hop;
+    s32 i;
+
+    if (onGoalMap)
+    {
+        if (candidate == 0)
+        {
+            if (goal->x == 0xFF)
+                return FALSE; // already where the goal wants us
+            FillPush(fill, goal->x + MAP_OFFSET, goal->y + MAP_OFFSET, FIELD_GOAL);
+            return TRUE;
+        }
+        candidate--;
+    }
+    if (candidate >= LT_NAV_CANDIDATES)
+        return FALSE;
+
+    mapIndex = sLtNavGroupStart[gSaveBlock1Ptr->location.mapGroup] + gSaveBlock1Ptr->location.mapNum;
+    if (gSaveBlock1Ptr->location.mapGroup >= ARRAY_COUNT(sLtNavGroupStart) || mapIndex >= LT_NAV_NUM_MAPS)
+        return FALSE;
+    hop = sLtNavRoutes[goal->route][mapIndex][candidate];
+    if (hop == 0)
+        return FALSE;
+
+    if (hop >= LT_NAV_HOP_WARP)
+    {
+        const struct MapEvents *events = gMapHeader.events;
+
+        hop -= LT_NAV_HOP_WARP;
+        if (events == NULL || hop >= events->warpCount)
+            return FALSE;
+        FillPush(fill, events->warps[hop].x + MAP_OFFSET, events->warps[hop].y + MAP_OFFSET, FIELD_GOAL);
+        return TRUE;
+    }
+    else
+    {
+        // A map edge: every tile on that edge from which the next map can be walked onto
+        s32 mapWidth = gMapHeader.mapLayout->width;
+        s32 mapHeight = gMapHeader.mapLayout->height;
+        bool32 any = FALSE;
+
+        if (hop == CONNECTION_NORTH || hop == CONNECTION_SOUTH)
+        {
+            s32 y = (hop == CONNECTION_NORTH) ? MAP_OFFSET : MAP_OFFSET + mapHeight - 1;
+            s32 beyond = (hop == CONNECTION_NORTH) ? y - 1 : y + 1;
+
+            for (i = MAP_OFFSET; i < MAP_OFFSET + mapWidth; i++)
+            {
+                if (TileWalkable(i, y, fill->canSurf) && TileWalkable(i, beyond, fill->canSurf))
+                {
+                    FillPush(fill, i, y, hop == CONNECTION_NORTH ? DIR_NORTH : DIR_SOUTH);
+                    any = TRUE;
+                }
+            }
+        }
+        else
+        {
+            s32 x = (hop == CONNECTION_WEST) ? MAP_OFFSET : MAP_OFFSET + mapWidth - 1;
+            s32 beyond = (hop == CONNECTION_WEST) ? x - 1 : x + 1;
+
+            for (i = MAP_OFFSET; i < MAP_OFFSET + mapHeight; i++)
+            {
+                if (TileWalkable(x, i, fill->canSurf) && TileWalkable(beyond, i, fill->canSurf))
+                {
+                    FillPush(fill, x, i, hop == CONNECTION_WEST ? DIR_WEST : DIR_EAST);
+                    any = TRUE;
+                }
+            }
+        }
+        return any;
+    }
+}
+
+// People and objects that stay put are obstacles: the path goes around them. Wandering people are
+// ignored (they move), and so are things the player deals with on the way: trees to cut, rocks
+// to smash and boulders to push.
+static bool32 IsFieldObstacleGfx(u8 graphicsId)
+{
+    return graphicsId == OBJ_EVENT_GFX_CUT_TREE
+        || graphicsId == OBJ_EVENT_GFX_ROCK_SMASH_ROCK
+        || graphicsId == OBJ_EVENT_GFX_PUSHABLE_BOULDER;
+}
+
+// A tree, rock or boulder only counts as "on the way" once the player is able to deal with it.
+static bool32 CanClearFieldObstacle(u8 graphicsId)
+{
+    switch (graphicsId)
+    {
+    case OBJ_EVENT_GFX_CUT_TREE:
+        return FlagGet(FLAG_BADGE02_GET) && LT_CanUseFieldMove(MOVE_CUT);
+    case OBJ_EVENT_GFX_PUSHABLE_BOULDER:
+        return FlagGet(FLAG_BADGE04_GET) && LT_CanUseFieldMove(MOVE_STRENGTH);
+    default:
+        return FALSE;
+    }
+}
+
+static bool32 WalksAbout(u8 movementType)
+{
+    return (movementType >= MOVEMENT_TYPE_WANDER_AROUND && movementType <= MOVEMENT_TYPE_WANDER_RIGHT_AND_LEFT)
+        || movementType >= MOVEMENT_TYPE_WALK_UP_AND_DOWN;
+}
+
+static void BlockTile(s32 x, s32 y)
+{
+    if (x >= 0 && y >= 0 && x < VMap.Xsize && y < VMap.Ysize)
+        sField[y * VMap.Xsize + x] = FIELD_BLOCKED;
+}
+
+// People and objects that stay put are obstacles: the path goes around them. People who walk
+// about are ignored (they move) unless the last path ran into one. Trees to cut and boulders to
+// push block the way until the player can deal with them.
+// The map's own list of objects is used, because the game only brings objects to life when the
+// player is near them.
+static void BlockStandingObjects(void)
+{
+    const struct MapEvents *events = gMapHeader.events;
+    u8 i;
+
+    if (events != NULL)
+    {
+        for (i = 0; i < events->objectEventCount && i < OBJECT_EVENT_TEMPLATES_COUNT; i++)
+        {
+            const struct ObjectEventTemplate *template = &gSaveBlock1Ptr->objectEventTemplates[i];
+
+            if (template->kind != OBJ_KIND_NORMAL)
+                continue;
+            if (template->flagId != 0 && FlagGet(template->flagId))
+                continue; // hidden or already dealt with
+            if (IsFieldObstacleGfx(template->graphicsId))
+            {
+                if (CanClearFieldObstacle(template->graphicsId))
+                    continue;
+            }
+            else if (WalksAbout(template->objUnion.normal.movementType))
+            {
+                continue;
+            }
+            BlockTile(template->x + MAP_OFFSET, template->y + MAP_OFFSET);
+        }
+    }
+
+    if (sAvoidEveryone)
+    {
+        for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+        {
+            const struct ObjectEvent *obj = &gObjectEvents[i];
+
+            if (obj->active && !obj->isPlayer && !IsFieldObstacleGfx(obj->graphicsId))
+                BlockTile(obj->currentCoords.x, obj->currentCoords.y);
+        }
+    }
+}
+
+// True if somebody (not a tree, rock or boulder) is standing on the tile the arrow points into,
+// and that tile is not the goal itself.
+static bool32 SomeoneInTheWay(u8 dir)
+{
+    s32 x = gSaveBlock1Ptr->pos.x + MAP_OFFSET + sDirDelta[dir][0];
+    s32 y = gSaveBlock1Ptr->pos.y + MAP_OFFSET + sDirDelta[dir][1];
+    u8 i;
+
+    if (sField == NULL || x < 0 || y < 0 || x >= VMap.Xsize || y >= VMap.Ysize
+     || sField[y * VMap.Xsize + x] == FIELD_GOAL)
+        return FALSE;
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        const struct ObjectEvent *obj = &gObjectEvents[i];
+
+        if (obj->active && !obj->isPlayer && !IsFieldObstacleGfx(obj->graphicsId)
+         && obj->currentCoords.x == x && obj->currentCoords.y == y)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static u8 FieldAtPlayer(void)
+{
+    s32 x = gSaveBlock1Ptr->pos.x + MAP_OFFSET;
+    s32 y = gSaveBlock1Ptr->pos.y + MAP_OFFSET;
+
+    if (sField == NULL || x < 0 || y < 0 || x >= VMap.Xsize || y >= VMap.Ysize)
+        return FIELD_UNVISITED;
+    return sField[y * VMap.Xsize + x];
+}
+
+// Stairs and exit mats are goals you stand on and then push against. Which way to push?
+static u8 PushDirectionAtPlayer(void)
+{
+    u8 behavior = MapGridGetMetatileBehaviorAt(gSaveBlock1Ptr->pos.x + MAP_OFFSET, gSaveBlock1Ptr->pos.y + MAP_OFFSET);
+
+    if (MetatileBehavior_IsSouthArrowWarp(behavior))
+        return DIR_SOUTH;
+    if (MetatileBehavior_IsNorthArrowWarp(behavior))
+        return DIR_NORTH;
+    if (MetatileBehavior_IsWestArrowWarp(behavior) || MetatileBehavior_IsDirectionalUpLeftStairWarp(behavior)
+     || MetatileBehavior_IsDirectionalDownLeftStairWarp(behavior))
+        return DIR_WEST;
+    if (MetatileBehavior_IsEastArrowWarp(behavior) || MetatileBehavior_IsDirectionalUpRightStairWarp(behavior)
+     || MetatileBehavior_IsDirectionalDownRightStairWarp(behavior))
+        return DIR_EAST;
+    return 0;
+}
+
+static void BuildField(u8 goalId)
+{
+    const struct LtNavGoal *goal = &sLtNavGoals[goalId];
+    struct Fill fill;
+    u32 size = VMap.Xsize * VMap.Ysize;
+    u8 candidate;
+
+    if (sField != NULL)
+        Free(sField);
+    sField = NULL;
+
+    sBuiltGoal = goalId;
+    sBuiltMapGroup = gSaveBlock1Ptr->location.mapGroup;
+    sBuiltMapNum = gSaveBlock1Ptr->location.mapNum;
+    sBuiltCanSurf = CanSurfNow();
+
+    fill.queue = Alloc(QUEUE_SIZE * sizeof(u16));
+    if (fill.queue == NULL)
+        return;
+    sField = Alloc(size);
+    if (sField == NULL)
+    {
+        Free(fill.queue);
+        return;
+    }
+    fill.width = VMap.Xsize;
+    fill.height = VMap.Ysize;
+    fill.canSurf = sBuiltCanSurf;
+
+    for (candidate = 0; candidate < LT_NAV_CANDIDATES + 1; candidate++)
+    {
+        u8 here;
+
+        memset(sField, FIELD_UNVISITED, size);
+        BlockStandingObjects();
+        fill.head = 0;
+        fill.count = 0;
+        if (!SeedCandidate(&fill, goal, candidate))
+            continue;
+        FillRun(&fill);
+        here = FieldAtPlayer();
+        if (here >= DIR_SOUTH && here <= FIELD_GOAL)
+            break; // this exit can be reached from where the player is standing
+    }
+    if (candidate == LT_NAV_CANDIDATES + 1)
+        memset(sField, FIELD_UNVISITED, size); // no way found: no arrow
+
+    Free(fill.queue);
+}
+
+// The heap is wiped when battles and menus start. Forget the pointer rather than free it later.
+void LT_Nav_OnHeapReset(void)
+{
+    sField = NULL;
+    sBuiltGoal = NO_GOAL;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The arrow sprite. It uses the player character's palette, which is always loaded on the field.
+// ---------------------------------------------------------------------------------------------
+
+#define TAG_LT_NAV_ARROW 0x1E10
+
+static const u8 sArrowGfx[] = INCBIN_U8("graphics/little_trainers/nav_arrow.4bpp");
+
+static const struct SpriteSheet sArrowSheet = {sArrowGfx, sizeof(sArrowGfx), TAG_LT_NAV_ARROW};
+
+static const struct OamData sArrowOam =
+{
+    .shape = SPRITE_SHAPE(16x16),
+    .size = SPRITE_SIZE(16x16),
+    .priority = 1, // above the map, below text windows and menus
+};
+
+static const union AnimCmd sArrowAnim_South[] = {ANIMCMD_FRAME(0, 1, .vFlip = TRUE), ANIMCMD_END};
+static const union AnimCmd sArrowAnim_North[] = {ANIMCMD_FRAME(0, 1), ANIMCMD_END};
+static const union AnimCmd sArrowAnim_West[] = {ANIMCMD_FRAME(4, 1, .hFlip = TRUE), ANIMCMD_END};
+static const union AnimCmd sArrowAnim_East[] = {ANIMCMD_FRAME(4, 1), ANIMCMD_END};
+
+static const union AnimCmd *const sArrowAnims[] =
+{
+    [DIR_SOUTH - 1] = sArrowAnim_South,
+    [DIR_NORTH - 1] = sArrowAnim_North,
+    [DIR_WEST - 1] = sArrowAnim_West,
+    [DIR_EAST - 1] = sArrowAnim_East,
+};
+
+static const struct SpriteTemplate sArrowTemplate =
+{
+    .tileTag = TAG_LT_NAV_ARROW,
+    .paletteTag = TAG_NONE,
+    .oam = &sArrowOam,
+    .anims = sArrowAnims,
+    .images = NULL,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCallbackDummy,
+};
+
+// Where the arrow sits relative to the player sprite, per direction, in pixels
+static const s8 sArrowOffset[][2] =
+{
+    [DIR_SOUTH] = {  0,  30},
+    [DIR_NORTH] = {  0, -24},
+    [DIR_WEST]  = {-20,   8},
+    [DIR_EAST]  = { 20,   8},
+};
+
+static struct Sprite *ArrowSprite(void)
+{
+    if (sArrowSpriteId < MAX_SPRITES && gSprites[sArrowSpriteId].inUse && gSprites[sArrowSpriteId].template == &sArrowTemplate)
+        return &gSprites[sArrowSpriteId];
+
+    // Sprites and their graphics are thrown away on every map change; make them again.
+    if (GetSpriteTileStartByTag(TAG_LT_NAV_ARROW) == 0xFFFF)
+        LoadSpriteSheet(&sArrowSheet);
+    sArrowSpriteId = CreateSprite(&sArrowTemplate, 0, 0, 0);
+    if (sArrowSpriteId >= MAX_SPRITES)
+        return NULL;
+    gSprites[sArrowSpriteId].invisible = TRUE;
+    return &gSprites[sArrowSpriteId];
+}
+
+static void ShowArrow(u8 dir)
+{
+    static const s8 sBob[] = {0, 1, 2, 1};
+    struct Sprite *arrow = ArrowSprite();
+    struct Sprite *player = &gSprites[gPlayerAvatar.spriteId];
+    s8 bob;
+
+    if (arrow == NULL)
+        return;
+    if (dir < DIR_SOUTH || dir > DIR_EAST)
+    {
+        arrow->invisible = TRUE;
+        return;
+    }
+
+    bob = sBob[(sBobTimer++ >> 3) & 3]; // a gentle nudge in the direction to walk
+    arrow->oam.paletteNum = player->oam.paletteNum;
+    // The camera keeps the player in the middle of the screen: their sprite is centred on (120, 72).
+    arrow->x = 120 + sArrowOffset[dir][0] + sDirDelta[dir][0] * bob;
+    arrow->y = 72 + sArrowOffset[dir][1] + sDirDelta[dir][1] * bob;
+    StartSpriteAnimIfDifferent(arrow, dir - 1);
+    arrow->invisible = FALSE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Called every frame while the player is on the field.
+// ---------------------------------------------------------------------------------------------
+
+void LT_Nav_Update(void)
+{
+    u8 goal, dir;
+
+    if (!LT_Rules()->navArrow || gQuestLogState == QL_STATE_PLAYBACK)
+        return; // (the game records its "quest log" during normal play; only a replay switches the arrow off)
+
+    if (ArePlayerFieldControlsLocked())
+    {
+        // A conversation, cut-scene or menu: keep out of the way
+        if (sArrowSpriteId < MAX_SPRITES && gSprites[sArrowSpriteId].inUse && gSprites[sArrowSpriteId].template == &sArrowTemplate)
+            gSprites[sArrowSpriteId].invisible = TRUE;
+        return;
+    }
+
+    goal = CurrentGoal();
+    if (goal == NO_GOAL)
+    {
+        ShowArrow(0);
+        return;
+    }
+
+    if (sField == NULL
+     || goal != sBuiltGoal
+     || gSaveBlock1Ptr->location.mapGroup != sBuiltMapGroup
+     || gSaveBlock1Ptr->location.mapNum != sBuiltMapNum
+     || CanSurfNow() != sBuiltCanSurf)
+    {
+        // Only start while standing still, so the short pause is never felt mid-step
+        if (gPlayerAvatar.tileTransitionState == T_TILE_TRANSITION)
+            return;
+        sAvoidEveryone = FALSE;
+        BuildField(goal);
+    }
+
+    dir = FieldAtPlayer();
+    if (gPlayerAvatar.tileTransitionState != T_TILE_TRANSITION)
+    {
+        if (dir >= DIR_SOUTH && dir <= DIR_EAST && !sAvoidEveryone && SomeoneInTheWay(dir))
+        {
+            // The way is blocked by a person: find a path around everybody instead
+            sAvoidEveryone = TRUE;
+            BuildField(goal);
+            dir = FieldAtPlayer();
+        }
+        else if (dir == FIELD_UNVISITED && sAvoidEveryone && ++sRetryTimer >= 120)
+        {
+            // No way around them: look again every couple of seconds in case they moved
+            sRetryTimer = 0;
+            sAvoidEveryone = FALSE;
+            BuildField(goal);
+            dir = FieldAtPlayer();
+        }
+    }
+    if (dir == FIELD_GOAL)
+        dir = PushDirectionAtPlayer();
+    ShowArrow(dir);
+}
