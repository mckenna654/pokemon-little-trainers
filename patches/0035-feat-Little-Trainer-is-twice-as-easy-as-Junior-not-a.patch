 // Engine code never hard-codes Little Trainers behaviour. It asks this module, e.g.
-//     if (LT_Rules()->guaranteedCatch) ...
+//     if (LT_Rules()->healAfterBattle) ...
 // so every rule can be tuned or switched off here, per difficulty preset.
 
 enum
@@ -23,9 +23,10 @@ enum
 struct LtRules
 {
     // Catching
-    bool8 guaranteedCatch;      // every ball thrown at a catchable wild Pokemon succeeds
     bool8 freeBalls;            // Poke Balls are never used up and are always available
-    u8 catchRatePercent;        // scales catch odds when not guaranteed (100 = original)
+    u16 catchRatePercent;       // scales the original game's catch odds (100 = original, 500 = five
+                                // times as likely). Never a certainty: the odds still depend on the
+                                // Pokemon, its health and the ball, as they always did.
 
     // Recovery and losing
     bool8 healAfterBattle;      // full party heal (HP, PP, status) when a battle ends
