+// Ground has heights (the Safari Zone's plateaus, cave ledges): you can only step between tiles
+// of the same height, or onto and off the "any height" tiles used for stairs and bridges.
+static bool32 SameLevel(s32 x1, s32 y1, s32 x2, s32 y2)
+{
+    u8 a = MapGridGetElevationAt(x1, y1);
+    u8 b = MapGridGetElevationAt(x2, y2);
+    bool32 waterA = MetatileBehavior_IsSurfable(MapGridGetMetatileBehaviorAt(x1, y1));
+    bool32 waterB = MetatileBehavior_IsSurfable(MapGridGetMetatileBehaviorAt(x2, y2));
+
+    if (waterA && waterB)
+        return TRUE;
+    if (waterA || waterB)
+        return (waterA ? b : a) == 3; // you can only get on and off a surfing Pokemon at ordinary ground level
+    return a == b || a == 0 || b == 0 || a == 15 || b == 15;
+}
