+// Little Trainers: save without asking, at story milestones. The usual save box and "SAVING..."
+// and "saved the game" messages are shown, so it is clear what is happening.
+static void Task_LtAutoSave(u8 taskId)
+{
+    if (RunSaveDialogCB() == SAVECB_RETURN_CONTINUE)
+        return;
+    ClearDialogWindowAndFrameToTransparent(0, TRUE);
+    ClearPlayerHeldMovementAndUnfreezeObjectEvents();
+    UnlockPlayerFieldControls();
+    RestoreHelpContext();
+    DestroyTask(taskId);
+}
+
+void LT_AutoSave(void)
+{
+    if (FuncIsActiveTask(Task_LtAutoSave))
+        return;
+    BackupHelpContext();
+    SetHelpContext(HELPCONTEXT_SAVE);
+    LockPlayerFieldControls();
+    FreezeObjectEvents();
+    StopPlayerAvatar();
+    SaveMapView();
+    PrintSaveStats();
+    sSaveDialogCB = SaveDialogCB_PrintSavingDontTurnOffPower; // straight to saving: no question
+    sSaveDialogIsPrinting = FALSE;
+    CreateTask(Task_LtAutoSave, 80);
+}
