+// Part of the graphical refresh: the overworld's colours are pushed away from grey (more
+// saturated) and lifted a little (brighter) as each tileset palette is loaded. Tiles, collision
+// and palette layout are untouched, so nothing about how maps behave changes.
+#define LT_VIVID_SATURATION_PERCENT 30
+#define LT_VIVID_LIFT               1
+
+void LT_VividPalette(u16 offset, u16 count)
+{
+    u16 i;
+
+    if (!LT_Rules()->vividColors)
+        return;
+
+    for (i = 0; i < count; i++)
+    {
+        u16 color = gPlttBufferUnfaded[offset + i];
+        s32 channel[3];
+        s32 mean;
+        u8 c;
+
+        channel[0] = color & 31;
+        channel[1] = (color >> 5) & 31;
+        channel[2] = (color >> 10) & 31;
+        mean = (channel[0] + channel[1] + channel[2]) / 3;
+        for (c = 0; c < 3; c++)
+        {
+            channel[c] += (channel[c] - mean) * LT_VIVID_SATURATION_PERCENT / 100;
+            if (mean > 6) // leave outlines and shadows dark
+                channel[c] += LT_VIVID_LIFT;
+            if (channel[c] < 0)
+                channel[c] = 0;
+            if (channel[c] > 31)
+                channel[c] = 31;
+        }
+        color = channel[0] | (channel[1] << 5) | (channel[2] << 10);
+        gPlttBufferUnfaded[offset + i] = color;
+        gPlttBufferFaded[offset + i] = color;
+    }
+}
