+// The "LITTLE TRAINERS" banner on the title screen: four 32x32 sprites side by side.
+#define TAG_LT_TITLE_BANNER 0x1E20
+
+// (u32 so the data is word-aligned: sprite sheets are copied to VRAM 16 bits at a time)
+static const u32 sTitleBannerGfx[] = INCBIN_U32("graphics/little_trainers/title_banner.4bpp");
+static const u16 sTitleBannerPal[] = INCBIN_U16("graphics/little_trainers/title_banner.gbapal");
+
+static const struct SpriteSheet sTitleBannerSheet = {(const u8 *)sTitleBannerGfx, sizeof(sTitleBannerGfx), TAG_LT_TITLE_BANNER};
+static const struct SpritePalette sTitleBannerPalette = {sTitleBannerPal, TAG_LT_TITLE_BANNER};
+
+static const struct OamData sTitleBannerOam =
+{
+    .shape = SPRITE_SHAPE(32x32),
+    .size = SPRITE_SIZE(32x32),
+    .priority = 0,
+};
+
+static const union AnimCmd sTitleBannerAnim0[] = {ANIMCMD_FRAME(0, 1), ANIMCMD_END};
+static const union AnimCmd sTitleBannerAnim1[] = {ANIMCMD_FRAME(16, 1), ANIMCMD_END};
+static const union AnimCmd sTitleBannerAnim2[] = {ANIMCMD_FRAME(32, 1), ANIMCMD_END};
+static const union AnimCmd sTitleBannerAnim3[] = {ANIMCMD_FRAME(48, 1), ANIMCMD_END};
+static const union AnimCmd *const sTitleBannerAnims[] = {sTitleBannerAnim0, sTitleBannerAnim1, sTitleBannerAnim2, sTitleBannerAnim3};
+
+static const struct SpriteTemplate sTitleBannerTemplate =
+{
+    .tileTag = TAG_LT_TITLE_BANNER,
+    .paletteTag = TAG_LT_TITLE_BANNER,
+    .oam = &sTitleBannerOam,
+    .anims = sTitleBannerAnims,
+    .images = NULL,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCallbackDummy,
+};
+
+#define TITLE_BANNER_X 6    // left edge of the 128x32 banner
+#define TITLE_BANNER_Y 94   // top edge
+
+void LT_ShowTitleBanner(void)
+{
+    u8 i;
+
+    if (GetSpriteTileStartByTag(TAG_LT_TITLE_BANNER) == 0xFFFF)
+        LoadSpriteSheet(&sTitleBannerSheet);
+    LoadSpritePalette(&sTitleBannerPalette);
+    for (i = 0; i < 4; i++)
+    {
+        u8 spriteId = CreateSprite(&sTitleBannerTemplate, TITLE_BANNER_X + 16 + 32 * i, TITLE_BANNER_Y + 16, 0);
+
+        if (spriteId < MAX_SPRITES)
+            StartSpriteAnim(&gSprites[spriteId], i);
+    }
+}
