From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mckenna654 <mckenna654@gmail.com>
Date: Thu, 26 Nov 2026 13:04:13 +1100
Subject: fix: no TOSS in the Berry Pouch either on Little and Junior; review
 notes

The Berry Pouch has its own item menu, and picking up any berry gives the
pouch, so keepEverything now leaves TOSS out there too (field: USE, GIVE,
EXIT; battle: USE, EXIT). Also from the code review: CanLeaveField checks
abilities on every battler as the engine does (no HP test); comments for
the Teleport and Ingrain effect of the run rule, the second meaning of
noEvolutionCancel and the CATCH fallback sound.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CNqSDphYuD2Aqe9TExdQMP

diff --git a/include/little_trainers.h b/include/little_trainers.h
index 2d2cdd448..6e53926b3 100644
--- a/include/little_trainers.h
+++ b/include/little_trainers.h
@@ -75,7 +75,9 @@ struct LtRules
 
     // Moves and evolution
     bool8 autoLearnMoves;       // new moves replace the weakest one automatically, no prompts
-    bool8 noEvolutionCancel;    // pressing B during an evolution does not stop it
+    bool8 noEvolutionCancel;    // pressing B during an evolution does not stop it, and no evolution is
+                                // started that the evolution scene would cancel (beyond the first
+                                // 151 Pokemon before the National Pokedex)
     u8 tradeEvoLevel;           // level at which trade evolutions happen by themselves (0 = trading only)
     u8 friendshipEvoThreshold;  // friendship needed for friendship evolutions (220 = original)
 
diff --git a/src/battle_controller_player.c b/src/battle_controller_player.c
index 087694315..7a38ae483 100644
--- a/src/battle_controller_player.c
+++ b/src/battle_controller_player.c
@@ -242,7 +242,7 @@ static void LtHandleInputSimpleMenu(void)
             }
             else if (IsPlayerPartyAndPokemonStorageFull())
             {
-                PlaySE(SE_FAILURE); // nowhere to put another Pokemon
+                PlaySE(SE_FAILURE); // nowhere to put another Pokemon (fallback: CATCH is hidden then)
                 return;
             }
             else
diff --git a/src/battle_main.c b/src/battle_main.c
index cd9171fee..12288f07a 100644
--- a/src/battle_main.c
+++ b/src/battle_main.c
@@ -3030,7 +3030,8 @@ u8 IsRunningFromBattleImpossible(void)
     s32 i;
 
     // Little Trainers: running from a wild Pokemon never fails, so Arena Trap, Shadow Tag, Magnet
-    // Pull and trapping moves do not stop it either (TryRunFromBattle then always succeeds).
+    // Pull, trapping moves and the player's own Ingrain do not stop it either (TryRunFromBattle
+    // then always succeeds). The player's Teleport, which asks the same question, works too.
     if (LT_BattleRulesActive() && LT_Rules()->alwaysRunAway && !(gBattleTypeFlags & BATTLE_TYPE_TRAINER)
      && GetBattlerSide(gActiveBattler) == B_SIDE_PLAYER)
         return BATTLE_RUN_SUCCESS;
