diff --git a/src/little_trainers_battle_ui.c b/src/little_trainers_battle_ui.c
new file mode 100644
index 000000000..59ccf8dae
--- /dev/null
+++ b/src/little_trainers_battle_ui.c
@@ -0,0 +1,229 @@
+#include "global.h"
+#include "gflib.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "battle_message.h"
+#include "data.h"
+#include "little_trainers.h"
+#include "menu.h"
+#include "strings.h"
+#include "constants/battle.h"
+#include "constants/pokemon.h"
+
+// Pokemon: Little Trainers - the picture battle menu.
+//
+// A row of large buttons (ATTACK, SPECIAL, CATCH or CHANGE, RUN) drawn over the battle message
+// box, with a pulsing ring around the selected button and a small word beside the row for
+// grown-ups. The art is our own (assets/ui/make_battle_icons.py in the project repository).
+//
+// It uses the window and background palette that the original game reserves for Professor Oak's
+// tutorial text, which are idle in every battle where this menu is active.
+
+static const u8 sIconsGfx[] = INCBIN_U8("graphics/little_trainers/battle_icons.4bpp");
+static const u8 sRingGfx[] = INCBIN_U8("graphics/little_trainers/battle_ring.4bpp");
+static const u8 sMarkerGfx[] = INCBIN_U8("graphics/little_trainers/battle_marker.4bpp");
+static const u16 sIconsPal[] = INCBIN_U16("graphics/little_trainers/battle_icons.gbapal");
+
+// Order of the buttons in battle_icons.png
+enum
+{
+    ICON_ATTACK,
+    ICON_SPARKLE,
+    ICON_FIRE,
+    ICON_WATER,
+    ICON_GRASS,
+    ICON_ELECTRIC,
+    ICON_ICE,
+    ICON_ROCK,
+    ICON_PSYCHIC,
+    ICON_CATCH,
+    ICON_CHANGE,
+    ICON_RUN,
+};
+
+#define MENU_WINDOW     B_WIN_OAK_OLD_MAN   // 208x32 pixels over the message box
+#define MENU_PALETTE    7
+#define BUTTON_SIZE     32
+#define BUTTON_BYTES    (BUTTON_SIZE * BUTTON_SIZE / 2)
+#define BUTTON_X(slot)  (2 + 34 * (slot))
+#define LABEL_X         140
+#define LABEL_WIDTH     68
+
+// Palette indices in battle_icons.pal
+#define COLOR_PANEL     1
+#define COLOR_DARK      2
+#define COLOR_WHITE     3
+#define COLOR_RING      14
+
+static EWRAM_DATA bool8 sCursorPlacedThisBattle = FALSE;
+static EWRAM_DATA u8 sBasicSlot = 0;
+static EWRAM_DATA u8 sSpecialSlot = 0;
+static EWRAM_DATA u8 sRecommended = 0;
+static EWRAM_DATA u8 sPulseTimer = 0;
+
+static const u8 sLabelColors[] = {COLOR_PANEL, COLOR_WHITE, COLOR_DARK};
+
+void LT_BattleMenu_Reset(void)
+{
+    sCursorPlacedThisBattle = FALSE;
+}
+
+u8 LT_BattleMenu_ButtonCount(void)
+{
+    if (gBattleTypeFlags & BATTLE_TYPE_TRAINER)
+        return LT_MENU_RUN; // no RUN button against trainers
+    return LT_MENU_COUNT;
+}
+
+static u8 SpecialIcon(u16 move)
+{
+    switch (gBattleMoves[move].type)
+    {
+    case TYPE_FIRE:
+        return ICON_FIRE;
+    case TYPE_WATER:
+        return ICON_WATER;
+    case TYPE_GRASS:
+    case TYPE_BUG:
+        return ICON_GRASS;
+    case TYPE_ELECTRIC:
+        return ICON_ELECTRIC;
+    case TYPE_ICE:
+        return ICON_ICE;
+    case TYPE_ROCK:
+    case TYPE_GROUND:
+        return ICON_ROCK;
+    case TYPE_PSYCHIC:
+    case TYPE_GHOST:
+        return ICON_PSYCHIC;
+    default:
+        return ICON_SPARKLE;
+    }
+}
+
+static u8 ButtonIcon(u8 battler, u8 slot)
+{
+    switch (slot)
+    {
+    case LT_MENU_ATTACK:
+        return ICON_ATTACK;
+    case LT_MENU_SPECIAL:
+        return SpecialIcon(gBattleMons[battler].moves[sSpecialSlot]);
+    case LT_MENU_CATCH_OR_CHANGE:
+        return (gBattleTypeFlags & BATTLE_TYPE_TRAINER) ? ICON_CHANGE : ICON_CATCH;
+    default:
+        return ICON_RUN;
+    }
+}
+
+static void DrawButton(u8 battler, u8 slot, bool32 selected)
+{
+    u16 x = BUTTON_X(slot);
+
+    FillWindowPixelRect(MENU_WINDOW, PIXEL_FILL(COLOR_PANEL), x, 0, BUTTON_SIZE, BUTTON_SIZE);
+    BlitBitmapToWindow(MENU_WINDOW, &sIconsGfx[ButtonIcon(battler, slot) * BUTTON_BYTES], x, 0, BUTTON_SIZE, BUTTON_SIZE);
+    if (slot == sRecommended)
+        BlitBitmapToWindow(MENU_WINDOW, sMarkerGfx, x + 21, 3, 8, 8);
+    if (selected)
+        BlitBitmapToWindow(MENU_WINDOW, sRingGfx, x, 0, BUTTON_SIZE, BUTTON_SIZE);
+}
+
+static void DrawLabel(u8 battler, u8 slot)
+{
+    const u8 *text;
+    u8 font = FONT_NORMAL;
+    s32 width;
+
+    switch (slot)
+    {
+    case LT_MENU_ATTACK:
+        text = gMoveNames[gBattleMons[battler].moves[sBasicSlot]];
+        break;
+    case LT_MENU_SPECIAL:
+        text = gMoveNames[gBattleMons[battler].moves[sSpecialSlot]];
+        break;
+    case LT_MENU_CATCH_OR_CHANGE:
+        text = (gBattleTypeFlags & BATTLE_TYPE_TRAINER) ? gText_LtChange : gText_LtCatch;
+        break;
+    default:
+        text = gText_LtRun;
+        break;
+    }
+
+    width = GetStringWidth(font, text, 0);
+    if (width > LABEL_WIDTH)
+    {
+        font = FONT_SMALL;
+        width = GetStringWidth(font, text, 0);
+        if (width > LABEL_WIDTH)
+            width = LABEL_WIDTH;
+    }
+    FillWindowPixelRect(MENU_WINDOW, PIXEL_FILL(COLOR_PANEL), LABEL_X, 0, LABEL_WIDTH, BUTTON_SIZE);
+    AddTextPrinterParameterized3(MENU_WINDOW, font, LABEL_X + (LABEL_WIDTH - width) / 2, 9, sLabelColors, TEXT_SKIP_DRAW, text);
+}
+
+void LT_BattleMenu_Show(u8 battler)
+{
+    u8 slot;
+    u8 count = LT_BattleMenu_ButtonCount();
+
+    LT_ChooseAttackSlots(battler, &sBasicSlot, &sSpecialSlot);
+    sRecommended = LT_RecommendedAttack(battler, sBasicSlot, sSpecialSlot);
+
+    // The first time the menu opens in a battle the cursor starts on the recommended attack,
+    // so simply pressing A does something sensible. After that it stays where the player left it.
+    if (!sCursorPlacedThisBattle)
+    {
+        gActionSelectionCursor[battler] = sRecommended;
+        sCursorPlacedThisBattle = TRUE;
+    }
+    if (gActionSelectionCursor[battler] >= count)
+        gActionSelectionCursor[battler] = LT_MENU_ATTACK;
+
+    BattlePutTextOnWindow(gText_EmptyString3, B_WIN_MSG);
+    LoadPalette(sIconsPal, BG_PLTT_ID(MENU_PALETTE), PLTT_SIZE_4BPP);
+    sPulseTimer = 0;
+
+    FillWindowPixelBuffer(MENU_WINDOW, PIXEL_FILL(COLOR_PANEL));
+    for (slot = 0; slot < count; slot++)
+        DrawButton(battler, slot, slot == gActionSelectionCursor[battler]);
+    DrawLabel(battler, gActionSelectionCursor[battler]);
+    PutWindowTilemap(MENU_WINDOW);
+    CopyWindowToVram(MENU_WINDOW, COPYWIN_FULL);
+}
+
+bool32 LT_BattleMenu_MoveCursor(u8 battler, s8 delta)
+{
+    u8 old = gActionSelectionCursor[battler];
+    s8 new = old + delta;
+
+    if (new < 0 || new >= LT_BattleMenu_ButtonCount())
+        return FALSE;
+
+    gActionSelectionCursor[battler] = new;
+    DrawButton(battler, old, FALSE);
+    DrawButton(battler, new, TRUE);
+    DrawLabel(battler, new);
+    CopyWindowToVram(MENU_WINDOW, COPYWIN_GFX);
+    return TRUE;
+}
+
+// Pulses the selection ring between yellow and white, so the selected button is shown by
+// movement as well as colour.
+void LT_BattleMenu_Tick(void)
+{
+    u16 color;
+
+    sPulseTimer++;
+    if (sPulseTimer & 0xF)
+        return;
+    color = (sPulseTimer & 0x10) ? RGB(31, 31, 31) : sIconsPal[COLOR_RING];
+    gPlttBufferUnfaded[BG_PLTT_ID(MENU_PALETTE) + COLOR_RING] = color;
+    gPlttBufferFaded[BG_PLTT_ID(MENU_PALETTE) + COLOR_RING] = color;
+}
+
+void LT_BattleMenu_Hide(void)
+{
+    // Redrawing the (empty) message window puts its own tiles and palette back.
+    BattlePutTextOnWindow(gText_EmptyString3, B_WIN_MSG);
+}
