+// How well a move slot would do against the current opponent: 0 if the move is unsuitable or
+// cannot affect it, otherwise its score adjusted for same-type bonus and type match-up.
+static u16 EffectiveScore(u8 battler, u8 slot)
+{
+    struct BattlePokemon *mon = &gBattleMons[battler];
+    u8 target = GetDefaultMoveTarget(battler);
+    u16 move = mon->moves[slot];
+    u16 score = LT_MoveScore(move);
+    u8 type, flags;
+
+    if (score == 0)
+        return 0;
+    if (move == MOVE_STRUGGLE)
+        return score;
+
+    flags = AI_TypeCalc(move, gBattleMons[target].species, gBattleMons[target].ability);
+    if (flags & MOVE_RESULT_DOESNT_AFFECT_FOE)
+        return 0;
+
+    type = gBattleMoves[move].type;
+    if (type == mon->type1 || type == mon->type2)
+        score = score * 3 / 2;
+    if ((flags & MOVE_RESULT_SUPER_EFFECTIVE) && !(flags & MOVE_RESULT_NOT_VERY_EFFECTIVE))
+        score *= 2;
+    else if ((flags & MOVE_RESULT_NOT_VERY_EFFECTIVE) && !(flags & MOVE_RESULT_SUPER_EFFECTIVE))
+        score = score / 2 + 1;
+    return score;
+}
 
